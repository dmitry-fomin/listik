#!/usr/bin/env python3
"""listik — трекер задач и память по всем проектам.

Сервер и доска:   listik serve
Работа агента:    listik claim / heartbeat / stage / comment / done
Поиск:            listik search "запрос"
"""
from __future__ import annotations

import argparse
import json
import os
import re
import sys
import traceback
from datetime import datetime, timezone
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent))

from listik import __version__, client, db, errors, paths, store  # noqa: E402
from listik import routes as routes_mod  # noqa: E402

STATUS_ICON = {"open": "○", "in_progress": "▶", "blocked": "■", "review": "◐",
               "done": "✓", "cancelled": "✕"}
STAGE_SHORT = {"s1-spec": "ТЗ", "s2-review": "крит", "s3-impl": "код", "s4-judge": "судья",
               "done": "готово"}

# ------------------------------------------------------------------ ошибки
#
# Любая ошибка выходит в одном формате (см. listik/errors.py): человеку — одна-две
# строки «ошибка: <что> — <как исправить>» в stderr, агенту с --json — объект
# {"error": {"code", "message", "hint"}} в stdout. Разбор аргументов, ответ сервера
# и локальный режим дают одинаковую структуру, а трейсбек непойманного исключения
# уходит только в listik.log.

_REQUIRED_ARG = re.compile(r"^the following arguments are required: (.+)$")
_UNRECOGNIZED_ARG = re.compile(r"^unrecognized arguments?: (.+)$")
_ARG_DETAIL = re.compile(r"^argument ([^:]+): (.*)$", re.S)
_INVALID_CHOICE = re.compile(r"^invalid choice: (.*?) \(choose from (.*)\)$")
_INVALID_NUMBER = re.compile(r"^invalid (?:int|float) value: (.*)$")
_PRIORITY = re.compile(r"^(?:[Pp])?([0-4])$")


def humanize_argparse(message: str) -> str:
    """Ошибка argparse по-русски и без «argument --x:» — подсказку добавит error()."""
    text = " ".join((message or "").split())
    arg, detail = "", text
    m = _ARG_DETAIL.match(text)
    if m:
        arg, detail = m.group(1), m.group(2).strip()
    m = _REQUIRED_ARG.match(detail)
    if m:
        return f"не хватает обязательного аргумента: {m.group(1)}"
    m = _UNRECOGNIZED_ARG.match(detail)
    if m:
        return f"неизвестный аргумент: {m.group(1)}"
    m = _INVALID_CHOICE.match(detail)
    if m:
        return (f"{arg}: " if arg else "") + \
            f"недопустимое значение {m.group(1)}; допустимо: {m.group(2)}"
    m = _INVALID_NUMBER.match(detail)
    if m:
        detail = f"ждёт целое число, получено {m.group(1)}"
    elif detail == "expected one argument":
        detail = "нужно значение"
    return f"{arg}: {detail}" if arg else detail


class ListikParser(argparse.ArgumentParser):
    """argparse, который не печатает usage-простыню, а отдаёт ошибку в общем формате.

    Переопределён `error`: любая ошибка разбора аргументов (нет заголовка, чужой
    флаг, плохое значение) становится ListikError с кодом bad_argument. Подкоманды
    наследуют этот класс от корневого парсера, поэтому формат один везде.
    """

    def error(self, message: str) -> None:  # type: ignore[override]
        raise errors.ListikError(humanize_argparse(message), code=errors.BAD_ARGUMENT,
                                 hint=f"{self.prog} --help", exit_code=2)


def priority_value(text: str) -> int:
    """Приоритет из аргумента: 0–4 или P0–P4 (show печатает «P2 обычный»)."""
    m = _PRIORITY.match(str(text).strip())
    if not m:
        raise errors.ListikError(
            "priority ждёт число 0–4 или P0–P4", code=errors.BAD_ARGUMENT, exit_code=2,
            hint="например: --priority 2, --priority P2, listik set <id> priority=P2")
    return int(m.group(1))


def report_error(exc: BaseException, json_mode: bool) -> int:
    """Печатает ошибку в общем формате и возвращает ненулевой код возврата."""
    err = errors.as_error(exc)
    if json_mode:
        print(json.dumps(errors.payload(err), ensure_ascii=False, indent=2))
    else:
        for line in errors.text_lines(err):
            print(line, file=sys.stderr)
    return err.exit_code


def log_traceback(exc: BaseException) -> None:
    """Трейсбек непойманного исключения — только в listik.log, не в терминал."""
    try:
        with open(paths.LOG_PATH, "a", encoding="utf-8") as fh:
            ts = datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
            fh.write(f"\n[{ts}] CLI: {' '.join(sys.argv)}\n")
            traceback.print_exception(type(exc), exc, exc.__traceback__, file=fh)
    except OSError:
        pass


def actor_default(args) -> str | None:
    return args.actor or os.environ.get("LISTIK_ACTOR") or os.environ.get("USER")


#: Операции `call()`, которые пишут в базу, — только им терять событие доски
#: (listik-f6kt). Список по операциям, а не по HTTP-методу: `dep_tree` и
#: `mentions` шлют POST, но это чтения графа, событий они не создают.
WRITE_OPS = frozenset({
    "create", "update", "claim", "heartbeat", "stage", "comment",
    "needs-owner", "dep_add", "dep_remove",
})

#: `--local` при живом сервере обходит push доски так же молча, как фолбэк без
#: сервера. Формулировка та же, что у фолбэка, но с подсказкой убрать --local:
#: сервер-то отвечает, и запись можно провести через него.
LOCAL_BYPASS_WARNING = (
    "! --local: команда пишет прямо в базу, минуя сервер — "
    "доска не получит событие (убери --local, чтобы доска обновилась)"
)


def warn_local_bypass(args, *, writing: bool) -> None:
    """`--local` при живом сервере и пишущей команде: предупредить в stderr.

    Сервер опрашиваем только для записей: чтению в `--local` терять нечего, и
    лишний health-запрос ему ни к чему (приёмка 2 listik-f6kt). Печать идёт
    строго в stderr, поэтому `--json` остаётся разбираемым в stdout.
    """
    if not writing or not getattr(args, "local", False):
        return
    try:
        up = client.is_up(getattr(args, "host", None), getattr(args, "port", None))
    except Exception:  # noqa: BLE001 — битый config.toml не должен ломать саму команду
        up = False
    if up:
        print(LOCAL_BYPASS_WARNING, file=sys.stderr)


def call(op: str, args, path: str, *, query: dict | None = None, body: dict | None = None,
         method: str = "GET", local_kwargs: dict | None = None):
    """Идём в сервер, если он поднят; иначе — прямо в базу (агент не должен падать)."""
    if getattr(args, "local", False):
        warn_local_bypass(args, writing=op in WRITE_OPS)
        if any((local_kwargs or {}).get(key) for key in ("route", "launch_route")):
            routes_mod.load_local()
        return client.local_call(op, **(local_kwargs or {}))
    if client.is_up(args.host, args.port):
        return client.request(method, path, query=query, body=body,
                              host=args.host, port=args.port)
    if not getattr(args, "local", False):
        print("! сервер Listik не отвечает — команда выполнена напрямую по базе "
              "(доска не получит событие; подними сервер: listik serve)", file=sys.stderr)
    # Маршруты в локальном режиме никто не загружал — это делает сервер при старте.
    # Дочитываем файл, только когда команда вообще трогает маршрут: метки
    # `harness:`/`process:` считает серверная логика (store + routes.labels_for),
    # и у `new --route`/`set route=` они должны быть те же, что у формы на доске.
    if any((local_kwargs or {}).get(key) for key in ("route", "launch_route")):
        routes_mod.load_local()
    return client.local_call(op, **(local_kwargs or {}))


def emit(args, payload, human: str) -> None:
    if getattr(args, "json", False):
        print(json.dumps(payload, ensure_ascii=False, indent=2))
    else:
        print(human)


def _dur(seconds) -> str:
    try:
        s = int(seconds)
    except (TypeError, ValueError):
        return "—"
    if s < 60:
        return f"{s} с"
    if s < 3600:
        return f"{s // 60} мин"
    if s < 86400:
        return f"{s // 3600} ч {s % 3600 // 60} мин"
    return f"{s // 86400} дн"


def label_of(t: dict, title_key: str, raw_key: str, fallback: str = "—") -> str:
    """Производная подпись карточки (`*_title`) с откатом на сырое поле.

    Подписи считает store (`row_to_task`), поэтому у карточки, пришедшей сырой
    строкой таблицы, их нет. Без отката вывод падал бы KeyError — а он выглядел
    как «не найдено» с советом «проверь идентификатор» (listik-xut1).
    """
    return t.get(title_key) or t.get(raw_key) or fallback


def task_line(t: dict, *, width: int = 96) -> str:
    icon = STATUS_ICON.get(t.get("status"), "?")
    stage = STAGE_SHORT.get(t.get("stage") or "", t.get("stage") or "")
    bits = [f"{icon} {t.get('id')}"]
    if t.get("project"):
        bits.append(f"[{t['project']}]")
    if stage:
        bits.append(f"этап {stage}")
    if t.get("holder"):
        holder = label_of(t, "holder_title", "holder")
        bits.append(f"держит {holder} {t.get('holder_age', '')}".strip())
    elif t.get("assignee"):
        bits.append(f"назначен {label_of(t, 'assignee_title', 'assignee')}")
    flags = []
    if t.get("needs_owner"):
        flags.append("НУЖЕН ТЫ")
    if t.get("stale"):
        flags.append("брошена")
    if t.get("abandoned"):
        flags.append("без держателя")
    if t.get("stage_warn"):
        flags.append(f"на этапе {t.get('stage_age')}")
    if t.get("blocked_by"):
        flags.append(f"блокеров {len(t['blocked_by'])}")
    head = "  ".join(bits)
    if flags:
        head += "  «" + ", ".join(flags) + "»"
    title = (t.get("title") or "").strip()
    if len(title) > width:
        title = title[:width - 1] + "…"
    return f"{head}\n     {title}"


def print_tasks(tasks: list[dict]) -> None:
    if not tasks:
        print("  пусто")
        return
    for t in tasks:
        print(task_line(t))
    print(f"\nвсего: {len(tasks)}")


def _soft_link_label(x: dict) -> str:
    """Подпись мягкой связи для текстового вывода: висячая связь — с пояснением,
    иначе dep_title (или тип связи, если названия нет)."""
    if x.get("missing"):
        return f"{x['id']} ({x['dep_type']}, задача не найдена)"
    return f"{x['id']} ({x.get('dep_title') or x['dep_type']})"


def show_task(t: dict) -> None:
    print(f"{STATUS_ICON.get(t.get('status'), '?')} {t.get('id')}")
    print(f"  заголовок:   {t.get('title')}")
    print(f"  проект:      {t.get('project') or '—'}   тип: {t.get('issue_type') or '—'}   "
          f"приоритет: {label_of(t, 'priority_title', 'priority')}")
    print(f"  статус:      {label_of(t, 'status_title', 'status')}"
          + (f"   этап: {label_of(t, 'stage_title', 'stage')} "
             f"(на этапе {t.get('stage_age') or '—'})"
             if t.get("stage") else ""))
    holder = label_of(t, "holder_title", "holder")
    if t.get("holder"):
        holder += f"   держит {t.get('holder_age') or '—'}"
        if t.get("holder_note"):
            holder += f" — {t['holder_note']}"
    print(f"  исполнитель: {label_of(t, 'assignee_title', 'assignee')}   держатель: {holder}")
    print(f"  создана:     {t.get('created_at') or '—'}   обновлена: {t.get('updated_at') or '—'}"
          f" ({t.get('updated_age') or '—'} назад)")
    if t.get("started_at"):
        print(f"  начата:      {t['started_at']}")
    if t.get("closed_at"):
        print(f"  закрыта:     {t['closed_at']}   причина: {t.get('close_reason') or '—'}")
    if t.get("needs_owner"):
        print("  *** ЖДЁТ ЧЕЛОВЕКА ***")
    if t.get("stale"):
        print(f"  !!! брошена: держатель молчит {t.get('holder_age') or '—'}")
    if t.get("blocked_by"):
        print(f"  заблокирована: {', '.join(t['blocked_by'])}")
    deps_state = t.get("deps_state")
    if deps_state:
        soft = deps_state.get("soft_links") or []
        suggested_ids = [x["id"] for x in soft if x.get("dep_type") == "suggested-blocks"]
        if suggested_ids:
            print(f"  предложены блокеры (не подтверждены): {', '.join(suggested_ids)}")
        others = [x for x in soft if x.get("dep_type") != "suggested-blocks"]
        if others:
            print(f"  связано (не блокирует): {', '.join(_soft_link_label(x) for x in others)}")
    if t.get("labels"):
        print(f"  метки:       {', '.join(t['labels'])}")
    if t.get("spec_path") or t.get("journal_path"):
        print(f"  ТЗ:          {t.get('spec_path') or '—'}")
        print(f"  журнал:      {t.get('journal_path') or '—'}")
    if t.get("documents"):
        print("\n  документы:")
        for d in t["documents"]:
            line = f"    {d.get('kind')} {d.get('path')} rev {d.get('revision')} чанков {d.get('chunk_count', 0)}"
            if d.get("status") == "missing":
                line += f" — ФАЙЛ НЕДОСТУПЕН: {d.get('error')}"
            print(line)
    if t.get("children"):
        print(f"\n  порции (дочерние карточки, {len(t['children'])}):")
        for ch in t["children"]:
            stage = f" · {ch.get('stage_title')}" if ch.get("stage") else ""
            holder = f" · держит {ch.get('holder_title')}" if ch.get("holder") else ""
            print(f"    {ch.get('id')} [{ch.get('status_title') or ch.get('status')}{stage}]{holder}"
                  f" — {ch.get('title')}")
            for d in ch.get("documents") or []:
                line = f"      {d.get('kind')} {d.get('path')} rev {d.get('revision')}"
                if d.get("status") == "missing":
                    line += " — ФАЙЛ НЕДОСТУПЕН"
                print(line)
    if t.get("worktree") or t.get("branch"):
        # `worktree=main`/`master` — маркер «работа в основной ветке, без дерева»
        # (API.md, `listik set <id> worktree=main`), а не путь: показываем словами.
        tree = store.main_worktree_title(t.get("worktree")) or t.get("worktree") or '—'
        print(f"  дерево:      {tree}   ветка: {t.get('branch') or '—'}")
    if t.get("launch_error"):
        print(f"  автостарт: ОШИБКА {t['launch_error']}")
    elif t.get("autostart") or t.get("launched_by"):
        bits = [f"автостарт: {t.get('launch_route') or '—'}"]
        if t.get("launched_by"):
            pid = t.get("launch_pid")
            launched = f"запущена {t['launched_by']} pid {pid if pid is not None else '—'}"
            if t.get("launched_at"):
                launched += f" {t['launched_at']}"
            bits.append(launched)
            code = t.get("launch_exit_code")
            bits.append(f"код {code if code is not None else 'идёт'}")
        print("  " + " · ".join(bits))
    elif t.get("launch_route"):
        # Маршрут без автостарта: сохранённый «тип запуска», запуска не было.
        print(f"  маршрут:     {t['launch_route']} (без автостарта)")
    if t.get("external_ref"):
        print(f"  старый ID ({t.get('source')}): {t['external_ref']}")
    for field, label in (("description", "описание"), ("acceptance", "приёмка"),
                         ("design", "дизайн"), ("notes", "заметки"), ("result", "результат")):
        value = (t.get(field) or "").strip()
        if value:
            print(f"\n  {label}:\n" + "\n".join("    " + line for line in value.splitlines()[:60]))
    if t.get("comments"):
        print(f"\n  история ({len(t['comments'])}):")
        for c in t["comments"][-25:]:
            text = (c.get("text") or "").strip()
            first = text.splitlines()[0] if text else ""
            print(f"    [{c.get('created_at')}] {c.get('author') or '?'} ({c.get('kind')}): {first[:140]}")
            for line in text.splitlines()[1:8]:
                print(f"        {line[:150]}")
    if t.get("events"):
        print("\n  события:")
        for e in t["events"][:20]:
            arrow = ""
            if e.get("from_value") or e.get("to_value"):
                arrow = f" {e.get('from_value') or '—'} → {e.get('to_value')}"
            dur = f" ({_dur(e['duration_s'])})" if e.get("duration_s") else ""
            print(f"    [{e['ts']}] {e['kind']}{arrow}{dur}"
                  + (f" — {e['note']}" if e.get("note") else ""))
    if t.get("dependencies"):
        print("\n  зависит от: " + ", ".join(d["depends_on"] for d in t["dependencies"]))
    if t.get("dependents"):
        print("  от неё зависят: " + ", ".join(d["issue_id"] for d in t["dependents"]))


# ------------------------------------------------------------------ команды

def cmd_serve(args) -> int:
    from listik import server
    cfg, token = client.config_mod.ensure_token()
    db.init()
    if not args.daemon:
        print(f"токен для агентов: {token}")
    server.serve(host=args.host, port=args.port, quiet=args.quiet, background=args.daemon,
                 no_embed=args.no_embed)
    return 0


def cmd_stop(args) -> int:
    from listik import server
    pid = server.read_pid()
    if not pid:
        # pid-файла нет, но порт может держать живой сервер Listik — найдём по порту.
        cfg = client.config_mod.load()
        holder = server.port_holder(int(args.port or cfg["server"]["port"]))
        if holder and server.is_listik_serve(holder[1]):
            pid = holder[0]
        elif holder:
            print(f"сервер Listik не запущен; порт занят чужим процессом pid {holder[0]}: {holder[1]}")
            return 1
        else:
            print("сервер не запущен")
            return 0
    os.kill(pid, 15)
    print(f"остановлен (pid {pid})")
    return 0


def cmd_status(args) -> int:
    from listik import server
    h = client.health(args.host, args.port)
    pid = server.read_pid()
    cfg, token = client.config_mod.ensure_token()
    url = f"http://{cfg['server']['host']}:{cfg['server']['port']}/?token={token}"
    if h is None:
        print("сервер: не отвечает" + (f" (pid-файл: {pid})" if pid else ""))
        print("поднять: listik serve --daemon")
        return 1
    print(f"сервер: работает{' (pid ' + str(pid) + ')' if pid else ''}")
    print(f"доска:  {url}")
    if h.get("authed") and h.get("counts"):
        c = h["counts"]
        print(f"база:   {h.get('db')}")
        print(f"данные: {c['tasks']} задач, {c['comments']} комментариев, "
              f"{c['events']} событий, {c['embeddings']} векторов")
        emb = h.get("embed") or {}
        print(f"поиск:  модель {emb.get('model')} "
              + ("готова" if emb.get("ok") else "НЕДОСТУПНА — векторов не будет"))
        # Последний сбой базы в фоновом потоке сервера: без этой строки о нём
        # молчал и status (listik-9csm). Снимается первым успешным проходом.
        db_error = h.get("db_error")
        if db_error:
            print(f"база:   ОШИБКА в фоне [{db_error.get('where')}] "
                  f"{db_error.get('at')}: {db_error.get('error')} — сбросится после "
                  "успешного прохода")
        # Подмена файла базы или WAL под работающим сервером (listik-cfzk): факт,
        # а не текущая ошибка, поэтому строка висит до перезапуска сервера.
        replaced = h.get("db_replaced")
        if replaced:
            print(f"база:   ПОДМЕНА ФАЙЛА [{replaced.get('kind')}] {replaced.get('at')}: "
                  f"{replaced.get('detail')} — соединения переоткрыты, подробности в listik.log")
    else:
        print("(подробности недоступны: токен не принят)")
    # Маршруты — только из ответа /api/health работающего сервера: сам status файл
    # routes.json не читает и не копирует.
    routes = h.get("routes")
    if routes:
        if routes.get("ok"):
            print(f"маршруты: {routes.get('count')} из {routes.get('path')}")
        else:
            print(f"маршруты: ОШИБКА {routes.get('error')} — автостарт выключен")
    return 0


def cmd_init(args) -> int:
    conn = db.init(verbose=True)
    print(f"база: {paths.DB_PATH}")
    for k, v in db.counts(conn).items():
        print(f"  {k:12s} {v}")
    return 0


def cmd_backup(args) -> int:
    """Штатная копия базы (listik-cfzk): sqlite backup API, можно при живом сервере."""
    from listik import backup as backup_mod
    info = backup_mod.backup(out_path=args.out, overwrite=args.force)
    c = info["counts"]
    emit(args, info,
         f"копия:  {info['backup']}\n"
         f"база:   {info['db']}\n"
         f"размер: {info['bytes']} байт, integrity_check: {info['integrity']}\n"
         f"данные: {c['tasks']} задач, {c['comments']} комментариев, {c['events']} событий\n"
         f"восстановить: listik restore {info['backup']}  (сервер должен быть остановлен)")
    return 0


def cmd_restore(args) -> int:
    """Восстановление из копии (listik-cfzk): при работающем сервере отказывает."""
    from listik import backup as backup_mod
    info = backup_mod.restore(args.backup, stop=args.stop, force=args.force)
    c = info["counts"]
    lines = [
        f"восстановлено: {info['db']}",
        f"из копии:      {info['backup']}",
        f"данные:        {c['tasks']} задач, {c['comments']} комментариев, "
        f"{c['events']} событий (integrity_check: {info['integrity']})",
    ]
    if info.get("safety_copy"):
        lines.append(f"на случай отката: {info['safety_copy']}")
    if info.get("removed_sidecars"):
        lines.append("удалён журнал прежней базы: "
                     + ", ".join(Path(p).name for p in info["removed_sidecars"]))
    srv = info.get("server") or {}
    if srv.get("stopped"):
        lines.append(f"сервер остановлен (pid {srv.get('pid')}) — подними его: listik serve --daemon")
    if info.get("warning"):
        lines.append(f"! {info['warning']}")
    emit(args, info, "\n".join(lines))
    return 0


def cmd_init_projects(args) -> int:
    """Прописать правила Listik в AGENTS.md/CLAUDE.md всех проектов (блок между маркерами)."""
    from listik import migrate
    conn = db.init()
    rows = conn.execute(
        "SELECT slug, path FROM projects WHERE path IS NOT NULL AND archived = 0 ORDER BY slug"
    ).fetchall()
    dirs = []
    for r in rows:
        if args.only and args.only not in r["slug"]:
            continue
        candidate = Path(r["path"])
        if candidate.is_dir():
            dirs.append(candidate)
    print(f"проектов к обработке: {len(dirs)}"
          + (" (dry-run, ничего не записано)" if args.dry_run else ""))
    report = migrate.migrate_all(dirs, dry_run=args.dry_run, remove_block=args.remove,
                                 verbose=not args.quiet)
    print("\nдобавлено: {added}, обновлено: {updated}, без изменений: {unchanged}, "
          "удалено блоков: {removed}, пропущено: {skipped}".format(**{
              k: len(v) for k, v in report.items()}))
    if not args.dry_run and not args.remove:
        print("\nДальше по каждому проекту: выключить авто-экспорт beads, чтобы репозиторий "
              "перестал коммитить .beads/issues.jsonl — см. docs/beads-migration.md")
    return 0


def cmd_import(args) -> int:
    from listik import import_beads
    conn = db.init()
    print(f"ищу .beads в {paths.PROJECTS_ROOT} …")
    report = import_beads.import_all(conn, only=args.only, dry_run=args.dry_run,
                                     verbose=not args.quiet)
    if report["skipped_duplicates"]:
        print("\nдубликаты трекеров (пропущены):")
        for d in report["skipped_duplicates"]:
            print(f"  ! {d['slug']} — тот же префикс {d['prefix']}, что и у {d['winner']}; "
                  f"задач в копии: {d['issues']}")
    print(f"\nпроектов: {report['projects']}, задач: {report['tasks']}, "
          f"комментариев: {report['comments']}, связей: {report['deps']}, "
          f"памятей beads: {report['memories']}"
          + (f", пропущено уже импортированных: {report['skipped_tasks']}"
             if report["skipped_tasks"] else ""))
    if report["dry_run"]:
        print("(dry-run: ничего не записано)")
    return 0


def cmd_import_writerllm(args) -> int:
    from listik import import_writerllm
    conn = db.init()
    report = import_writerllm.import_file(conn, args.source, project=args.project,
                                          dry_run=args.dry_run, update=args.update)
    if args.json:
        print(json.dumps(report, ensure_ascii=False, indent=2))
        return 0 if report["ok"] else 1

    print(f"WriterLLM → проект {report['project']} (источник: {report['source']})")
    print(f"записей: {report['total']}   создано: {report['created']}   "
          f"обновлено: {report['updated']}   пропущено: {report['skipped']}   "
          f"игнорировано: {report['ignored']}   связей: {report['dependencies']}   "
          f"комментариев: {report['comments']}   ошибок: {len(report['errors'])}")
    for entry in report["examples"]["create"][:5]:
        line = f"  create  {entry['external_ref']}  «{entry['title']}»"
        if entry.get("remapped"):
            line += f"  (id: {entry['id']} — старый занят)"
        print(line)
    for entry in report["examples"]["skip"][:5]:
        print(f"  skip    {entry['external_ref']}  «{entry['title']}»")
    for entry in report["examples"]["update"][:5]:
        print(f"  update  {entry['external_ref']}  «{entry['title']}»  "
              f"({', '.join(entry['fields'])})")
    for err in report["errors"][:10]:
        where = err.get("where")
        if where == "record" and err.get("line") is not None:
            print(f"  ! строка {err['line']}: {err['error']}")
        elif where == "dependency":
            print(f"  ! запись {err.get('external_ref')}, связь → {err.get('target_ref')}: {err['error']}")
        else:
            ref = err.get("external_ref") or err.get("line")
            print(f"  ! {where} {ref}: {err['error']}")
    if report["warnings"]:
        print(f"предупреждений: {len(report['warnings'])} (подробности в --json)")
    if args.dry_run:
        print("(dry-run: ничего не записано)")
    return 0 if report["ok"] else 1


def cmd_new(args) -> int:
    if args.autostart and not (args.route or "").strip():
        # Задача не создаётся: запускать автостарт нечем, а молча создать её без
        # маршрута — значит соврать галочке. Код 2 — как у parser.error.
        raise errors.ListikError("--autostart требует --route <ключ маршрута из routes.json>",
                                 code=errors.BAD_ARGUMENT, exit_code=2,
                                 hint="например: listik new \"заголовок\" --autostart "
                                      "--route low-pipeline")
    body = {
        "title": args.title, "project": args.project, "type": args.type,
        "priority": args.priority, "description": args.description or "",
        "acceptance": args.acceptance or "", "stage": args.stage,
        "assignee": args.assignee, "labels": args.label or [],
        "spec_path": args.spec, "journal_path": args.journal,
        "checklist_path": args.checklist,
        "review_path": args.review, "decision_path": args.decision,
        "actor": actor_default(args), "harness": args.harness,
        "autostart": args.autostart, "route": args.route,
        "parent": args.parent,
    }
    local = dict(body)
    local.pop("type", None)
    local.pop("actor", None)
    local.pop("harness", None)
    local["issue_type"] = args.type
    local["created_by"] = actor_default(args)
    local["parent"] = args.parent
    task = call("create", args, "/api/tasks", method="POST", body=body, local_kwargs=local)
    emit(args, task, f"создана {task['id']}"
         + (f"  [{task['project']}]" if task.get("project") else "")
         + (f"\n  порция шага: {task['id']} → родитель {args.parent}" if args.parent else "")
         + f"\n  {task['title']}")
    return 0


def cmd_list(args) -> int:
    kwargs = {
        "project": args.project, "status": args.status, "stage": args.stage,
        "assignee": args.assignee, "holder": args.holder, "issue_type": args.type,
        "needs_owner": args.needs_owner, "include_closed": args.all,
        "limit": args.limit, "order": args.order,
    }
    if args.mine:
        kwargs["holder"] = kwargs["holder"] or actor_default(args)
    if args.stale:
        kwargs["status"] = "in_progress"
    res = call("list", args, "/api/tasks",
               query={k: (str(v).lower() if isinstance(v, bool) else v)
                      for k, v in kwargs.items() if v is not None},
               local_kwargs=kwargs)
    tasks = res["tasks"]
    if args.stale:
        tasks = [t for t in tasks if t.get("stale") or t.get("abandoned")]
    if getattr(args, "json", False):
        print(json.dumps(res, ensure_ascii=False, indent=2))
    else:
        print_tasks(tasks)
    return 0


def cmd_show(args) -> int:
    task = call("show", args, f"/api/tasks/{args.task_id}", local_kwargs={"task_id": args.task_id})
    if getattr(args, "json", False):
        print(json.dumps(task, ensure_ascii=False, indent=2))
    else:
        show_task(task)
    return 0


def cmd_context(args) -> int:
    query = {"stage": args.stage, "portion": args.portion, "max_chars": args.max_chars}
    out = call("context", args, f"/api/tasks/{args.task_id}/context", query=query,
               local_kwargs={"task_id": args.task_id, "stage": args.stage,
                             "portion": args.portion, "max_chars": args.max_chars})
    if args.format == "json" or getattr(args, "json", False):
        print(json.dumps(out, ensure_ascii=False, indent=2))
        return 0
    card = out.get("card") or {}
    print(f"контекст {card.get('id') or args.task_id} · этап {out['stage']}")
    print(f"{card.get('title', '')} [{card.get('project') or '—'}] "
          f"статус {card.get('status')} этап {card.get('stage')} держит {card.get('holder') or '—'}")
    if out.get("portion"):
        portion_card = out.get("portion_card")
        if portion_card:
            print(f"порция:      «{out['portion']}» → карточка {portion_card.get('id')} "
                  f"({portion_card.get('title')})")
        else:
            print(f"порция:      «{out['portion']}» (дочерняя карточка не найдена — "
                  f"отбор по разделам ТЗ)")
    if out.get("parent"):
        print(f"родитель:    {out['parent'].get('id')} — {out['parent'].get('title')}")
    children = out.get("children") or []
    if children:
        print(f"порции шага ({len(children)}):")
        for ch in children:
            print(f"  - {ch.get('id')} [{ch.get('status')}"
                  + (f"/{ch.get('stage')}" if ch.get("stage") else "") + f"] {ch.get('title')}")
            for d in ch.get("documents") or []:
                print(f"      {d.get('kind')}: {d.get('path')} rev {d.get('revision')}")
    if card.get("spec_path"):
        print(f"spec: {card['spec_path']}")
    if card.get("checklist_path"):
        print(f"checklist: {card['checklist_path']}")
    if card.get("review_path"):
        print(f"review: {card['review_path']}")
    if card.get("decision_path"):
        print(f"decision: {card['decision_path']}")
    print(f"\nacceptance:\n{out.get('acceptance', '')}")
    deps = out.get("dependencies") or {}
    if deps.get("hard"):
        print("\nзависимости:")
        for d in deps["hard"]:
            print(f"  - {d.get('depends_on')} [{d.get('dep_type')}] {d.get('status')} — {d.get('title')}")
        print(f"  verdict: {deps.get('verdict')}")
    if deps.get("suggested"):
        print("\nпредложенные блокеры (не подтверждены):")
        for d in deps["suggested"]:
            print(f"  - {d.get('depends_on')} [{d.get('dep_type')}] {d.get('status')} — {d.get('title')}")
    for doc in out.get("documents", []):
        print(f"\n## {doc.get('title') or doc['path']} [{doc['kind']}] rev {doc['revision']} статус {doc.get('status')}")
    for chunk in out.get("chunks", []):
        heading = chunk.get("breadcrumb") or chunk.get("heading") or "раздел"
        print(f"\n### {heading} ({chunk.get('path')}:{chunk.get('start_line')}-{chunk.get('end_line')}) — {chunk.get('reason')}")
        print(chunk.get("text", ""))
    if out.get("reviews"):
        print("\nreviews:")
        for r in out["reviews"]:
            print(f"  - {r.get('author')}: {r.get('text')}")
    if out.get("verdict"):
        print(f"\nverdict: {out['verdict'].get('author')}: {out['verdict'].get('text')}")
    if out.get("journal"):
        print("\njournal:")
        for j in out["journal"]:
            print(f"  - {j.get('ts')} [{j.get('kind')}] {j.get('actor')}: {j.get('text')}")
    wt = out.get("worktree")
    if wt:
        if wt.get("mode") == "main":
            # Маркер основной ветки: `path` — репозиторий проекта, а не поле карточки.
            print(f"\nworktree: {wt.get('title') or 'работа в основной ветке'}"
                  f" — репозиторий проекта {wt.get('path') or '—'}")
        else:
            print(f"\nworktree: {wt.get('path') or '—'}")
        if wt.get("exists"):
            print(f"  ветка: {wt.get('branch') or '—'}   head: {wt.get('head') or '—'}")
            changed = wt.get("changed_files") or []
            print(f"  изменённых файлов: {len(changed)}")
            if wt.get("diff_stat"):
                print(wt["diff_stat"].rstrip("\n"))
        if wt.get("reason"):
            print(f"  ({wt['reason']})")
    if out.get("limits", {}).get("truncated"):
        print(f"\n[контекст обрезан: {out['limits'].get('reason')}]")
    return 0


def cmd_set(args) -> int:
    fields = {}
    for pair in args.field:
        if "=" not in pair:
            raise errors.ListikError(f"ожидалось поле=значение, получено: {pair}",
                                     code=errors.BAD_ARGUMENT,
                                     hint="например: listik set <id> status=in_progress priority=P2")
        key, value = pair.split("=", 1)
        key = key.strip()
        if key == "labels":
            value = [x.strip() for x in value.split(",") if x.strip()]
        elif key == "priority":
            value = priority_value(value)
        elif key == "needs_owner":
            value = value.lower() in ("1", "true", "yes", "да")
        fields[key] = value
    fields["actor"] = actor_default(args)
    fields["harness"] = args.harness
    if args.note:
        fields["note"] = args.note
    body = dict(fields)
    local = dict(fields)
    local.pop("actor", None)
    local.pop("harness", None)
    local["actor"] = fields["actor"]
    local["task_id"] = args.task_id
    task = call("update", args, f"/api/tasks/{args.task_id}", method="PATCH", body=body,
                local_kwargs=local)
    emit(args, task, task_line(task))
    return 0


def _holder_action(args, action: str) -> int:
    body = {"holder": args.holder or actor_default(args), "harness": args.harness,
            "note": args.note}
    if action == "claim" and getattr(args, "force", False):
        body["force"] = True
    task = call(action, args, f"/api/tasks/{args.task_id}/{action}", method="POST", body=body,
                local_kwargs={**body, "task_id": args.task_id})
    if getattr(args, "json", False):
        print(json.dumps(task, ensure_ascii=False, indent=2))
    else:
        print(task_line(task))
    return 0


def cmd_claim(args) -> int:
    return _holder_action(args, "claim")


def cmd_heartbeat(args) -> int:
    return _holder_action(args, "heartbeat")


def cmd_stage(args) -> int:
    if args.to:
        holder = args.holder or actor_default(args)
        # Explicit targets use the same server-side routing/holder semantics as
        # the ordinary next-stage command.
        body = {"to": args.to, "holder": holder, "harness": args.harness, "note": args.note}
        local = {"task_id": args.task_id, "to_stage": args.to, "holder": holder,
                 "harness": args.harness, "note": args.note}
        task = call("stage", args, f"/api/tasks/{args.task_id}/stage", method="POST", body=body,
                    local_kwargs=local)
    else:
        body = {"holder": args.holder or actor_default(args), "harness": args.harness,
                "note": args.note}
        task = call("stage", args, f"/api/tasks/{args.task_id}/stage", method="POST", body=body,
                    local_kwargs={**body, "task_id": args.task_id})
    if getattr(args, "json", False):
        print(json.dumps(task, ensure_ascii=False, indent=2))
    else:
        print(task_line(task))
        if task.get("stage_unchanged"):
            # Задача уже на этом этапе: store ничего не менял (listik-xut1).
            print(f"  {task.get('message') or 'этап не менялся'}")
    return 0


def cmd_comment(args) -> int:
