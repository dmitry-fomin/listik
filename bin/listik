def cmd_portions(args) -> int:
    """`portions sync`: карточки порций по файлам шага `<id>.<X>.md`."""
    actor = actor_default(args)
    harness = getattr(args, "harness", None)
    try:
        res = call("portions_sync", args, f"/api/tasks/{args.task_id}/portions/sync",
                   method="POST", body={"actor": actor, "harness": harness},
                   local_kwargs={"task_id": args.task_id, "actor": actor, "harness": harness})
    except (errors.ListikError, ValueError) as exc:
        # Нет spec_path/каталога шага — неверный аргумент: код 2, как у прочих bad_argument.
        err = errors.as_error(exc)
        if err.code != errors.BAD_ARGUMENT:
            raise
        raise errors.ListikError(err.message, code=err.code, hint=err.hint,
                                 exit_code=2, status=err.status) from exc
    if getattr(args, "json", False):
        emit(args, res, "")
        return 0
    for p in res["portions"]:
        state = ("создана" if p["id"] in res["created"] else
                 "обновлена" if p["id"] in res["updated"] else "без изменений")
        print(f"  {p['letter']}  {p['id']}  {state}  {p['title']}")
    if not res["portions"]:
        print(f"  файлов порций нет в {res['steps_dir']}")
    links = ", ".join(f"{cur} ждёт {prev}" for prev, cur in res["linked"])
    print(f"связи: {links or 'без изменений'}")
    return 0


def cmd_revoke(args) -> int:
    actor = actor_default(args)
    kill = not args.no_kill
    body = {"actor": actor, "harness": args.harness, "note": args.note, "kill": kill}
    task = call("revoke", args, f"/api/tasks/{args.task_id}/revoke", method="POST", body=body,
                local_kwargs={"task_id": args.task_id, "actor": actor, "harness": args.harness,
                              "note": args.note, "kill": kill})
    emit(args, task, f"полномочия отозваны: {task['id']} — поколение {task.get('generation')}")
    if not getattr(args, "json", False):
        journal = [c for c in (task.get("comments") or [])
                  if c.get("author") == "agent:listik" and c.get("kind") == "journal"
                  and "отозваны" in (c.get("text") or "")]
        if journal:
            print(f"  {journal[-1]['text']}")
    return 0


def cmd_launch(args) -> int:
    actor = actor_default(args)
    env = {}
    for pair in args.env or []:
        if "=" not in pair:
            raise errors.ListikError(f"--env ожидало K=V, получено {pair!r}",
                                     code=errors.BAD_ARGUMENT, exit_code=2,
                                     hint="например: --env LISTIK_DEV_PORT=5173")
        key, value = pair.split("=", 1)
        env[key] = value
    body = {"actor": actor, "harness": args.harness}
    if env:
        body["env"] = env
    task = call("launch", args, f"/api/tasks/{args.task_id}/launch", method="POST", body=body,
                local_kwargs={"task_id": args.task_id, "actor": actor, "harness": args.harness})
    if task.get("launched") is False:
        # Режим роя без процесса: этап пропущен, задача нарезана или отказ
        # ушёл в «нужен человек» — это не ошибка (docs/specs/swarm-stage-launch.md).
        detail = ("вопрос человеку (needs_owner)" if task.get("needs_owner")
                  else f"этап пропущен, теперь {task.get('stage_skipped')}"
                  if task.get("stage_skipped")
                  else "родитель нарезан — бегут порции" if task.get("reason") == "sliced"
                  else "без запуска")
        line = f"рой: {task['id']} — запуска нет ({detail})"
    else:
        line = (f"запущена: {task['id']} — поколение {task.get('generation')}, "
                f"pid {task.get('launch_pid')}, лог {task.get('launch_log')}")
    if env:
        line += "\n  окружение: " + ", ".join(f"{k}={v}" for k, v in env.items())
    emit(args, task, line)
    return 0


def cmd_search(args) -> int:
    from listik import search as search_mod
    filt = {"project": args.project, "stage": args.stage, "status": args.status}
    res = call("search", args, "/api/search",
               query={"q": args.query, "limit": args.limit, "mode": args.mode, **filt},
               local_kwargs={"query": args.query, "limit": args.limit, "mode": args.mode, **filt})
    if getattr(args, "json", False):
        emit(args, res, "")
    else:
        search_mod.print_results(res)
    return 0


def cmd_memory(args) -> int:
    from listik import search as search_mod
    if args.query:
        items = call("memory", args, "/api/memory",
                     query={"q": args.query, "limit": args.limit, "project": args.project},
                     local_kwargs={"query": args.query, "limit": args.limit,
                                   "project": args.project})
        if getattr(args, "json", False):
            emit(args, items, "")
        else:
            search_mod.print_memories(items)
        return 0
    conn = db.init()
    rows = conn.execute(
        "SELECT key, project, body, updated_at FROM memories "
        + ("WHERE project LIKE ? " if args.project else "")
        + "ORDER BY updated_at DESC LIMIT ?",
        ([f"%{args.project}%"] if args.project else []) + [args.limit]).fetchall()
    if getattr(args, "json", False):
        emit(args, [dict(r) for r in rows], "")
        return 0
    if not rows:
        print("памяти пока нет (появятся командой listik remember)")
        return 0
    for r in rows:
        body = " ".join((r["body"] or "").split())
        print(f"● {r['key']}\n    {body[:220]}")
    print(f"\nвсего: {len(rows)}")
    return 0


def cmd_remember(args) -> int:
    out = store.remember(db.init(), args.text, key=args.key, project=args.project)
    print(f"запомнено: {out['key']}")
    return 0


def store_now() -> str:
    from datetime import datetime, timezone
    return datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def cmd_ready(args) -> int:
    """Что можно взять прямо сейчас: без незакрытых блокеров и без держателя."""
    res = call("ready", args, "/api/ready",
               query={"project": args.project, "stage": args.stage,
                      "include_occupied": str(args.with_occupied).lower(),
                      "limit": args.limit},
               local_kwargs={"project": args.project, "stage": args.stage,
                             "include_occupied": args.with_occupied, "limit": args.limit})
    tasks = res["tasks"]
    if getattr(args, "json", False):
        emit(args, res, "")
        return 0
    if not tasks:
        print("нечего брать: у всех задач есть незакрытые блокеры или держатель")
    for t in tasks:
        occ = f" (уже держит {t['holder_title']})" if t.get("holder") else ""
        wait = f"  [за ней ждут {t['waiting_for_count']}]" if t.get("waiting_for_count") else ""
        print(f"{STATUS_ICON.get(t['status'], '?')} {t['id']:38s} P{t['priority']} "
              f"[{t['project'] or '—'}]{occ}{wait}")
        print(f"     {t['title'][:110]}")
    if res.get("cycles"):
        print(f"\n! циклы в зависимостях: {len(res['cycles'])} — см. listik dep cycles")
    print(f"\nвсего готовых: {len(tasks)}")
    return 0


def cmd_waves(args) -> int:
    """Волны запуска: разложение открытых задач проекта на слои, что можно делать
    одновременно (Кан по жёстким зависимостям + арбитраж по write_scope/дереву)."""
    project = args.project
    if not project:
        raise errors.ListikError(
            "нужен проект: волны считаются по одному проекту", code=errors.BAD_ARGUMENT,
            hint="listik waves --project <slug>")
    apply_ = getattr(args, "apply", False)
    if apply_:
        res = call("waves_apply", args, "/api/waves/apply", method="POST",
                   body={"project": project, "stage": args.stage},
                   local_kwargs={"project": project, "stage": args.stage})
    else:
        res = call("waves", args, "/api/waves",
                   query={"project": project, "stage": args.stage},
                   local_kwargs={"project": project, "stage": args.stage})

    waves_plan = res.get("waves") if apply_ else res
    if getattr(args, "json", False):
        emit(args, res, "")
        return 1 if waves_plan.get("cycles") else 0

    tasks = waves_plan.get("tasks") or {}

    def _line(tid: str) -> str:
        info = tasks.get(tid)
        if info is None:
            return tid
        title = (info.get("title") or "")[:80]
        return f"{tid}  P{info.get('priority')}  {title}"

    lines: list[str] = []
    layers = waves_plan.get("waves") or []
    for i, wave in enumerate(layers):
        prefix = f"волна {i}: "
        indent = " " * len(prefix)
        for j, tid in enumerate(wave):
            lines.append(f"{prefix if j == 0 else indent}{_line(tid)}")

    unroutable = waves_plan.get("unroutable") or []
    if unroutable:
        lines.append("без маршрута (нужен человек): " + ", ".join(unroutable))

    unscoped = waves_plan.get("unscoped") or []
    if unscoped:
        lines.append("без области записи (нужен rescope): " + ", ".join(unscoped))

    blocked = waves_plan.get("blocked") or {}
    if blocked:
        lines.append("стоят: " + ", ".join(
            f"{tid} (ждёт {reason})" for tid, reason in blocked.items()))

    resource_blocks = waves_plan.get("resource_blocks") or []
    if resource_blocks:
        lines.append("ресурсные рёбра: " + ", ".join(
            f"{a} → {b}" for a, b in resource_blocks))

    cycles = waves_plan.get("cycles") or []
    for cycle in cycles:
        lines.append("циклы: " + " → ".join([*cycle, cycle[0]]))

    if not lines:
        lines.append("волн нет")

    if apply_:
        added = res.get("added") or []
        removed = res.get("removed") or []
        kept = res.get("kept") or 0
        if added or removed:
            lines.append("записано рёбер: %d (%s)" % (
                len(added), ", ".join(f"{a} → {b}" for a, b in added)))
            lines.append("снято: %d (%s)" % (
                len(removed), ", ".join(f"{a} → {b}" for a, b in removed)))
            lines.append("без изменений: %d" % kept)
        else:
            lines.append("рёбра без изменений")

    print("\n".join(lines))
    return 1 if cycles else 0


def _swarm_view(health: dict | None) -> dict:
    """Рой для status: с живого сервера, иначе по конфигу и swarm.pid."""
    from listik import swarm_proc
    if health and isinstance(health.get("swarm"), dict):
        return health["swarm"]
    try:
        enabled = client.config_mod.swarm_enabled()
    except ValueError as exc:
        return {"enabled": False, "running": False, "pid": None, "error": str(exc)}
    pid = swarm_proc.dispatcher_pid()
    return {"enabled": enabled, "running": pid is not None, "pid": pid}


def _print_swarm(health: dict | None) -> None:
    info = _swarm_view(health)
    if info.get("error"):
        print(f"рой:    конфиг: {info['error']}")
        return
    if not info.get("enabled"):
        print("рой:    выключен (listik swarm on)")
        return
    if info.get("running"):
        pid = info.get("pid")
        print(f"рой:    работает{f' (pid {pid})' if pid else ''}")
    else:
        print("рой:    включён, процесс не запущен")


def cmd_swarm(args) -> int:
    """Включить или выключить рой в config.toml. Сервер подхватывает сам."""
    state = args.state
    if state == "status":
        info = _swarm_view(None)
        if getattr(args, "json", False):
            emit(args, {k: v for k, v in info.items() if k != "error"}, "")
            return 0
        _print_swarm(None)
        if info.get("enabled") and not info.get("running"):
            print("его поднимает listik serve; если сервер уже работает — подожди несколько секунд")
        return 0
    enabled = state == "on"
    client.config_mod.set_swarm_enabled(enabled)
    if enabled:
        print("рой включён: [swarm] enabled = true")
        print("живой сервер на этой машине подхватит флаг в течение нескольких секунд")
    else:
        print("рой выключен: [swarm] enabled = false")
        print("живой сервер на этой машине остановит процесс в течение нескольких секунд")
    return 0


def cmd_plan(args) -> int:
    """LLM-проход роя: грубые зависимости `blocks` между открытыми задачами проекта —
    какие ТЗ можно писать параллельно."""
    project = args.project
    if not project:
        raise errors.ListikError(
            "нужен проект: план считается по одному проекту", code=errors.BAD_ARGUMENT,
            hint="listik plan --project <slug>")
    apply_ = getattr(args, "apply", False)
    stage = args.stage
    res = call("swarm_plan", args, "/api/swarm/plan", method="POST",
              body={"project": project, "stage": stage, "apply": apply_},
              local_kwargs={"project": project, "stage": stage, "apply": apply_},
              timeout=3600)

    cycles = res.get("cycles") or []
    if getattr(args, "json", False):
        emit(args, res, "")
        return 1 if cycles else 0

    lines = [f"план {project}: задач {len(res.get('tasks') or {})}, "
            f"модель {res.get('model')}, попыток {res.get('attempts')}"]

    tasks = res.get("tasks") or {}
    without_deps: list[str] = []
    for tid, info in tasks.items():
        depends_on = info.get("depends_on") or []
        if depends_on:
            reason = info.get("reason") or ""
            lines.append(f"{tid} ждёт {', '.join(depends_on)} — {reason}")
        else:
            without_deps.append(tid)
    if without_deps:
        if len(without_deps) == len(tasks):
            lines.append("все задачи без зависимостей")
        else:
            lines.append("без зависимостей: " + ", ".join(without_deps))

    for item in res.get("dropped") or []:
        why = item.get("why")
        if "depends_on" in item:
            lines.append(f"отброшено: {item.get('id')} → {item.get('depends_on')} ({why})")
        else:
            lines.append(f"отброшено: {item.get('id')} ({why})")

    for cycle in cycles:
        lines.append("цикл: " + " → ".join([*cycle, cycle[0]]))
    if cycles and res.get("cycles_from") == "db":
        lines.append("цикл уже в базе: разорви listik dep rm <id> <блокер>")

    if apply_:
        applied = res.get("applied")
        if cycles:
            lines.append("рёбра не записаны: цикл")
        elif applied:
            added = applied.get("added") or []
            removed = applied.get("removed") or []
            kept = applied.get("kept") or 0
            covered = applied.get("covered") or []
            lines.append("записано рёбер: %d (%s)" % (
                len(added), ", ".join(f"{a} → {b}" for a, b in added)))
            lines.append("снято: %d (%s)" % (
                len(removed), ", ".join(f"{a} → {b}" for a, b in removed)))
            lines.append("без изменений: %d" % kept)
            lines.append("уже есть смысловые: %d" % len(covered))

    print("\n".join(lines))
    return 1 if cycles else 0


def cmd_rescope(args) -> int:
    """LLM-проход роя: области read_scope/write_scope из готовых ТЗ и уточнение графа
    по копилке расхождений."""
    project = args.project
    if not project:
        raise errors.ListikError(
            "нужен проект: rescope считается по одному проекту", code=errors.BAD_ARGUMENT,
            hint="listik rescope --project <slug>")
    apply_ = getattr(args, "apply", False)
    tasks = getattr(args, "task", None)
    drift = None
    drift_path = getattr(args, "drift", None)
    if drift_path:
        try:
            with open(drift_path, encoding="utf-8") as fh:
                drift = json.load(fh)
        except (OSError, json.JSONDecodeError) as exc:
            raise errors.ListikError(
                f"--drift {drift_path}: не удалось прочитать JSON ({exc})",
                code=errors.BAD_ARGUMENT) from exc
        if not isinstance(drift, list):
            raise errors.ListikError(
                f"--drift {drift_path}: ожидался список записей",
                code=errors.BAD_ARGUMENT)

    res = call("swarm_rescope", args, "/api/swarm/rescope", method="POST",
              body={"project": project, "tasks": tasks, "drift": drift, "apply": apply_},
              local_kwargs={"project": project, "tasks": tasks, "drift": drift,
                            "apply": apply_},
              timeout=3600)

    cycles = res.get("cycles") or []
    if getattr(args, "json", False):
        emit(args, res, "")
        return 1 if cycles else 0

    tasks_out = res.get("tasks") or {}
    lines = [f"rescope {project}: задач {len(tasks_out)}, ТЗ прочитано "
            f"{res.get('extracted')}, модель {res.get('model')}, "
            f"попыток {res.get('attempts')}"]

    for tid, info in tasks_out.items():
        if info.get("source") != "spec":
            continue
        write_scope = info.get("write_scope") or []
        read_scope = info.get("read_scope") or []
        suffix = " (изменено)" if info.get("changed") else ""
        line = f"{tid}: правит {', '.join(write_scope)}"
        if read_scope:
            line += f"; читает {', '.join(read_scope)}"
        lines.append(line + suffix)

    unspecced = res.get("unspecced") or {}
    if unspecced:
        lines.append("без ТЗ: " + ", ".join(f"{tid} ({why})" for tid, why in unspecced.items()))

    unscoped = res.get("unscoped") or []
    if unscoped:
        lines.append("без области в ТЗ: " + ", ".join(unscoped))

    invalid = res.get("invalid") or {}
    for tid, why in invalid.items():
        lines.append(f"негодный ответ: {tid} — {why}")

    for tid, info in tasks_out.items():
        depends_on = info.get("depends_on") or []
        if depends_on:
            reason = info.get("reason") or ""
            lines.append(f"{tid} ждёт {', '.join(depends_on)} — {reason}")

    for item in res.get("dropped") or []:
        why = item.get("why")
        if "depends_on" in item:
            lines.append(f"отброшено: {item.get('id')} → {item.get('depends_on')} ({why})")
        else:
            lines.append(f"отброшено: {item.get('id')} ({why})")

    for cycle in cycles:
        lines.append("цикл: " + " → ".join([*cycle, cycle[0]]))
    if cycles and res.get("cycles_from") == "db":
        lines.append("цикл уже в базе: разорви listik dep rm <id> <блокер>")

    drift_info = res.get("drift") or {}
    lines.append("качество ТЗ: расхождений у %d из %d задач (%d файлов вне области, "
                "записей %d, отброшено %d)" % (
                    drift_info.get("tasks_with_drift", 0), drift_info.get("tasks_total", 0),
                    drift_info.get("outside_files", 0), drift_info.get("records", 0),
                    drift_info.get("ignored", 0)))

    if apply_:
        applied = res.get("applied")
        if applied:
            scopes = applied.get("scopes") or []
            lines.append("записано областей: %d (%s)" % (len(scopes), ", ".join(scopes)))
            edges_applied = applied.get("edges")
            if cycles or edges_applied is None:
                lines.append("рёбра не записаны: цикл")
            else:
                added = edges_applied.get("added") or []
                removed = edges_applied.get("removed") or []
                kept = edges_applied.get("kept") or 0
                covered = edges_applied.get("covered") or []
                lines.append("записано рёбер: %d (%s)" % (
                    len(added), ", ".join(f"{a} → {b}" for a, b in added)))
                lines.append("снято: %d (%s)" % (
                    len(removed), ", ".join(f"{a} → {b}" for a, b in removed)))
                lines.append("без изменений: %d" % kept)
                lines.append("уже есть смысловые: %d" % len(covered))

    print("\n".join(lines))
    return 1 if cycles else 0


class _SwarmCards:
    """Порт карточек для `swarm_watch.scan` поверх `call()` (CLI/HTTP/`--local`).

    Актор записей лестницы (`revoke`/`release`/`set_labels`) фиксирован —
    `agent:listik-swarm`: решение машинное, `--actor`/`LISTIK_OWNER` его не
    подменяют (лестница swarm-5, порция c).
    """

    ACTOR = "agent:listik-swarm"

    def __init__(self, args) -> None:
        self._args = args

    def _guard(self, fn, *args, **kwargs):
        """`ValueError`/`KeyError` порта (`store`/`launcher`) — в `ListikError`;
        `errors.ListikError` (в том числе `unsupported` локального фолбэка на
        `revoke`) уже в нужном виде и проходит как есть."""
        try:
            return fn(*args, **kwargs)
        except errors.ListikError:
            raise
        except (ValueError, KeyError) as exc:
            raise errors.as_error(exc) from exc

    def show(self, task_id: str) -> dict:
        return call("show", self._args, f"/api/tasks/{task_id}",
                   local_kwargs={"task_id": task_id})

    def comment(self, task_id: str, text: str) -> dict:
        body = {"text": text, "kind": "journal", "author": "agent:listik-swarm"}
        return call("comment", self._args, f"/api/tasks/{task_id}/comment", method="POST",
                   body=body, local_kwargs={**body, "task_id": task_id})

    def revoke(self, task_id: str, note: str) -> dict:
        body = {"actor": self.ACTOR, "harness": None, "note": note, "kill": True}
        return self._guard(call, "revoke", self._args, f"/api/tasks/{task_id}/revoke",
                           method="POST", body=body,
                           local_kwargs={"task_id": task_id, "actor": self.ACTOR,
                                         "harness": None, "note": note, "kill": True})

    def release(self, task_id: str, note: str) -> dict:
        body = {"actor": self.ACTOR, "note": note}
        return self._guard(call, "update", self._args, f"/api/tasks/{task_id}/release",
                           method="POST", body=body,
                           local_kwargs={"task_id": task_id, "holder": "", "actor": self.ACTOR,
                                         "note": note})

    def set_labels(self, task_id: str, labels: list[str]) -> dict:
        body = {"labels": labels, "actor": self.ACTOR}
        return self._guard(call, "update", self._args, f"/api/tasks/{task_id}", method="PATCH",
                           body=body,
                           local_kwargs={"task_id": task_id, "labels": labels,
                                         "actor": self.ACTOR})


def cmd_watch(args) -> int:
    """Наблюдатель деревьев роя: тронутые файлы, пробное слияние по парам, расхождения
    с write_scope, лестница реакций на конфликт (§2 порции c) — замораживает
    опоздавшего либо только отчитывается, если он уже не в работе."""
    project = (getattr(args, "project", None) or "").strip()
    if not project:
        raise errors.ListikError(
            "нужен проект: наблюдение считается по одному проекту", code=errors.BAD_ARGUMENT,
            hint="listik watch --project <slug>")

    res = call("projects", args, "/api/projects", local_kwargs={}, fallback_warning=False)
    proj = next((p for p in (res.get("projects") or []) if p.get("slug") == project), None)
    project_path = ((proj or {}).get("path") or "").strip()
    if not project_path:
        raise errors.ListikError(f"у проекта {project} не указан путь",
                                 code=errors.BAD_ARGUMENT, hint="listik projects --add <каталог>")
    worktree_mod.check_repo(project_path)

    list_res = call("list", args, "/api/tasks",
                    query={"project": project, "include_closed": "true", "limit": 1000},
                    local_kwargs={"project": project, "include_closed": True, "limit": 1000})
    all_tasks = list_res.get("tasks") or []
    truncated = bool(list_res.get("total", len(all_tasks)) > len(all_tasks))
    if truncated:
        print("! задач больше 1000, активное множество неполное", file=sys.stderr)

    task_filter = list(getattr(args, "task", None) or [])
    filter_skipped: dict[str, str] = {}
    if task_filter:
        by_id = {t.get("id"): t for t in all_tasks}
        tasks = []
        for tid in task_filter:
            t = by_id.get(tid)
            if t is None:
                filter_skipped[tid] = "unknown"
            else:
                tasks.append(t)
    else:
        tasks = all_tasks

    cards = _SwarmCards(args)
    result = swarm_watch.scan(project_path, tasks, cards,
                              dry_run=bool(getattr(args, "dry_run", False)))
    result["skipped"] = {**filter_skipped, **result["skipped"]}
    result["project"] = project
    result["truncated"] = truncated

    lines: list[str] = []
    for tid, t in result["tasks"].items():
        numstat = t.get("numstat") or {}
        added = sum(v["added"] for v in numstat.values() if v.get("added") is not None)
        deleted = sum(v["deleted"] for v in numstat.values() if v.get("deleted") is not None)
        uncounted = sum(1 for v in numstat.values() if v.get("added") is None)
        suffix = f" (+{uncounted} без счёта)" if uncounted else ""
        if t.get("frozen_by"):
            state = f"frozen:{t['frozen_by']}"
        elif t.get("live"):
            state = "live"
        else:
            state = "—"
        outside = t.get("outside_scope") or []
        outside_text = ", ".join(outside) if outside else "—"
        lines.append(f"{tid} {t.get('branch') or '—'} {state} файлов {len(t.get('files') or [])} "
                     f"+{added}/-{deleted}{suffix} вне области: {outside_text}")

    for p in result["probes"]:
        if "error" in p:
            lines.append(f"{p['a']} × {p['b']}: ошибка: {p['error']}")
        elif p.get("clean"):
            lines.append(f"{p['a']} × {p['b']}: чисто")
        else:
            lines.append(f"{p['a']} × {p['b']}: конфликт: {', '.join(p.get('conflicts') or [])}")

    for d in result["discrepancies"]:
        new = d.get("new") or []
        if new:
            lines.append(f"вне write_scope {d['task']}: {', '.join(new)}")

    # Лестница реакций (§2, порция c): решение ok:False не бросает исключение —
    # результат печатается целиком, ошибка идёт отдельной строкой в stderr, и код
    # возврата становится 1, чтобы рой заметил и результат, и провал.
    rc = 0
    for d in result["decisions"]:
        files_text = ", ".join(d.get("files") or [])
        if d["action"] == "report":
            lines.append(f"только отчёт: {d['task']} не в работе, конфликт с {d['owner']}: "
                         f"{files_text}")
            continue
        if not d.get("ok", True):
            lines.append(f"ОШИБКА заморозки {d['task']}: {d.get('error')}")
            err = errors.ListikError(d.get("error") or "", code=errors.CONFLICT)
            for line in errors.text_lines(err):
                print(line, file=sys.stderr)
            rc = 1
            continue
        if d.get("dry_run"):
            lines.append(f"заморозила бы {d['task']} (владелец {d['owner']}): {files_text}")
        elif d.get("resumed"):
            lines.append(f"заморозка доделана {d['task']} (владелец {d['owner']}): "
                         f"{files_text}")
        else:
            lines.append(f"заморожена {d['task']} (владелец {d['owner']}): {files_text}")

    for tid, reason in result["skipped"].items():
        lines.append(f"пропущено: {tid} ({reason})")

    emit(args, result, "\n".join(lines) if lines else "нечего наблюдать")
    return 0 if bool(getattr(args, "dry_run", False)) else rc


def cmd_blocked(args) -> int:
    """Кто кого ждёт: незакрытые блокеры и что из-за них стоит."""
    res = call("blocked", args, "/api/blocked",
               query={"project": args.project, "limit": args.limit},
               local_kwargs={"project": args.project, "limit": args.limit})
    tasks = res["tasks"]
    if getattr(args, "json", False):
        emit(args, res, "")
        return 0
    for t in tasks:
        print(f"■ {t['id']:38s} [{t['project'] or '—'}]  {t['title'][:80]}")
        for b in t["blockers"]:
            if b["missing"]:
                who = "задача не найдена"
            elif b["holder"]:
                who = f"держит {b['holder_title']} {b['idle_age']}"
            elif b["status"] in ("in_progress", "review"):
                who = f"в работе, но никто не держит ({b['idle_age']})"
            else:
                who = "никто не взял"
            print(f"      ← ждёт {b['id']:32s} {b['status']:12s} {who}")
        if t.get("blocked_by_stale"):
            print("      !!! все блокеры стоят без движения — возможно, пора вмешаться")
    print(f"\nвсего ждущих: {len(tasks)}")
    return 0


#: Сколько находок Stop-хук перечисляет в `reason`, остальные — «… и ещё K».
STOP_HOOK_MAX_LINES = 20


def lint_stop_hook(args) -> int:
    """`lint --stop-hook`: Stop-хук Claude Code. Находки — JSON-блок хода на stdout.

    Всегда код 0 и ничего в stderr: хук не должен ни зациклиться
    (`stop_hook_active`), ни заблокировать ход из-за собственной поломки.
    """
    try:
        try:
            payload = json.loads(sys.stdin.read() or "{}")
        except ValueError:
            payload = {}
        if isinstance(payload, dict) and payload.get("stop_hook_active") is True:
            return 0
        # Сервер лежит, а базы нет — не создаём её ни автоопределением проекта,
        # ни самим lint (local_call открывает базу через db.init).
        local = getattr(args, "local", False) or not client.is_up(args.host, args.port)
        if local and not paths.DB_PATH.exists():
            return 0
        project = project_default(args)
        if not project:
            return 0
        res = call("lint", args, "/api/lint", query={"project": project},
                   local_kwargs={"project": project}, fallback_warning=False)
        items = res["items"]
        if not items:
            return 0
        lines = [f"listik lint: {len(items)} несостыковок в проекте {project} — исправь "
                 "карточки (или объясни автору, почему нельзя) и заверши ход"]
        lines += [f"{i['id']}  {i['rule']}  {i['message']}"
                  for i in items[:STOP_HOOK_MAX_LINES]]
        if len(items) > STOP_HOOK_MAX_LINES:
            lines.append(f"… и ещё {len(items) - STOP_HOOK_MAX_LINES}")
        print(json.dumps({"decision": "block", "reason": "\n".join(lines)},
                         ensure_ascii=False))
    except Exception as exc:  # noqa: BLE001 — поломка хука не блокирует ход
        log_traceback(exc)
    return 0


def cmd_lint(args) -> int:
    """Несостыковки карточек проекта; код 1, если что-то нашлось."""
    if getattr(args, "stop_hook", False):
        if getattr(args, "json", False):
            raise errors.ListikError(
                "--stop-hook несовместим с --json", code=errors.BAD_ARGUMENT, exit_code=2,
                hint="listik lint --stop-hook (ответ хука и так JSON)")
        return lint_stop_hook(args)
    if not args.project:
        raise errors.ListikError(
            "укажи проект", code=errors.BAD_ARGUMENT, exit_code=2,
            hint="listik lint --project <slug> (или LISTIK_PROJECT, или запусти из "
                 "каталога проекта)")
    query = {"project": args.project}
    if args.suggested_hours is not None:
        if not args.suggested_hours > 0:
            raise errors.ListikError(
                "--suggested-hours ждёт число больше 0", code=errors.BAD_ARGUMENT,
                exit_code=2, hint="listik lint --suggested-hours 24")
        query["suggested_hours"] = args.suggested_hours
    res = call("lint", args, "/api/lint", query=query, local_kwargs=dict(query))
    rc = 1 if res["items"] else 0
    if getattr(args, "json", False):
        emit(args, res, "")
        return rc
    if not res["items"]:
        print("несостыковок нет")
        return rc
    rule = None
    for item in res["items"]:
        if item["rule"] != rule:
            rule = item["rule"]
            print(f"{rule}:")
        print(f"  {item['id']}  {item['message']}")
    return rc


def cmd_dep_tree(args) -> int:
    body = {"depth": args.depth}
    tree = call("dep_tree", args, f"/api/tasks/{args.task_id}/deps", method="POST", body=body,
                local_kwargs={"task_id": args.task_id, "depth": args.depth})
    if getattr(args, "json", False):
        emit(args, tree, "")
        return 0
    root = tree["task"]
    print(f"{root['id']} — {root['title'][:100]}  [{root['status']}]")

    def draw(nodes, prefix="", arrow="← ждёт"):
        for i, node in enumerate(nodes):
            last = i == len(nodes) - 1
            branch = "└─ " if last else "├─ "
            who = f", держит {node['holder_title']} {node['idle_age']}" if node.get("holder_title") and node["holder_title"] != "—" else ""
            print(f"{prefix}{branch}{arrow} {node['id']} [{node['status']}{who}] {node['title'][:70]}")
            draw(node.get("up") or node.get("down") or [], prefix + ("   " if last else "│  "), arrow)

    if tree["waits_for"]:
        print("ждёт завершения:")
        draw(tree["waits_for"])
    if tree["waited_by"]:
        print("её ждут:")
        draw(tree["waited_by"], arrow="→ ждёт её")
    if not tree["waits_for"] and not tree["waited_by"]:
        print("связей-блокировок нет")
    if tree.get("soft_links"):
        print("связано (не блокирует): " + ", ".join(_soft_link_label(x)
                                                    for x in tree["soft_links"][:8]))
    return 0


def cmd_dep_cycles(args) -> int:
    conn = db.init()
    from listik import deps as deps_mod
    found = deps_mod.cycles(conn)
    if getattr(args, "json", False):
        emit(args, found, "")
        return 0
    if not found:
        print("циклов нет")
        return 0
    for cycle in found:
        print("цикл: " + " → ".join(cycle))
    return 0


def cmd_inbox(args) -> int:
    """Что требует человека: вопросы, брошенные задачи и всё, что ждёт решения."""
    res = call("board", args, "/api/board",
               query={"group_by": "status", "include_closed": "false",
                      "project": args.project},
               local_kwargs={"group_by": "status", "project": args.project})
    items = res.get("needs_you") or []
    questions = [t for t in items if t.get("needs_owner")]
    dropped = [t for t in items if not t.get("needs_owner")]
    if getattr(args, "json", False):
        emit(args, {"questions": questions, "dropped": dropped}, "")
        return 0
    print(f"ВОПРОСЫ К ТЕБЕ ({len(questions)})")
    if not questions:
        print("  нет")
    for t in questions:
        print(f"  ▶ {t['id']}  [{t.get('project') or '—'}]  ждёт {t.get('idle_age')}")
        print(f"     {t['title'][:120]}")
        if t.get("holder_note"):
            print(f"     держатель: {t['holder_title']} — {t['holder_note'][:100]}")
    print(f"\nВИСИТ БЕЗ ДВИЖЕНИЯ ({len(dropped)})")
    for t in dropped[: args.limit]:
        why = "в работе без держателя" if t.get("abandoned") else "держатель молчит"
        print(f"  ■ {t['id']:40s} {why:24s} {t.get('idle_age')}")
    if len(dropped) > args.limit:
        print(f"  … и ещё {len(dropped) - args.limit}")
    return 0


def cmd_board(args) -> int:
    res = call("board", args, "/api/board",
               query={"group_by": args.group_by, "project": args.project,
                      "include_closed": str(args.all).lower()},
               local_kwargs={"group_by": args.group_by, "project": args.project,
                             "include_closed": args.all})
    if getattr(args, "json", False):
        emit(args, res, "")
        return 0
    if res.get("needs_you"):
        print(f"=== НУЖЕН ТЫ ({len(res['needs_you'])}) ===")
        for t in res["needs_you"][:15]:
            why = "ждёт автора" if t["needs_owner"] else ("брошена" if t["stale"] else "без держателя")
            print(f"  {t['id']:38s} {why:14s} {t.get('holder_age') or '—':>6s}  {t['title'][:80]}")
        print()
    for col in res["columns"]:
        print(f"=== {col['title']} — {col['count']}"
              + (f" (в работе {col['wip']})" if col.get("wip") else "")
              + (f", ждут тебя {col['needs_owner']}" if col.get("needs_owner") else "")
              + (f", брошено {col['stale']}" if col.get("stale") else "") + " ===")
        for t in col["tasks"][:40]:
            print(task_line(t, width=80))
        print()
    return 0


def cmd_stats(args) -> int:
    res = call("stats", args, "/api/stats", query={"project": args.project},
               local_kwargs={"project": args.project})
    if getattr(args, "json", False):
        emit(args, res, "")
        return 0
    print("по статусам:  " + ", ".join(f"{k}={v}" for k, v in res["by_status"].items()))
    print("по этапам:    " + ", ".join(f"{k}={v}" for k, v in res["by_stage"].items()))
    print(f"нужен человек: {res['needs_owner']}   брошено: {res['stale']}")
    print("\nпроекты:")
    for p in res["by_project"][:20]:
        print(f"  {p['total']:4d}  в работе {p['in_progress']:2d}  ждут {p['waiting']:2d}  {p['project']}")
    print("\nдержат прямо сейчас:")
    for h in res["by_holder"]:
        if h["holder"] != "—":
            print(f"  {h['count']:4d}  {h['title']} ({h['holder']})")
    if res["running"]:
        print("\nчто в работе:")
        for t in res["running"][:25]:
            print(f"  {STATUS_ICON.get(t['status'], '?')} {t['id']:38s} "
                  f"этап {t['stage_age']:>6s}  держит {t['holder_title']}  {t['title'][:60]}")
    return 0


def cmd_timeline(args) -> int:
    res = call("timeline", args, "/api/timeline",
               query={"limit": args.limit, "project": args.project},
               local_kwargs={"limit": args.limit, "project": args.project})
    if getattr(args, "json", False):
        emit(args, res, "")
        return 0
    for e in res["items"]:
        arrow = ""
        if e.get("from_value") or e.get("to_value"):
            arrow = f" {e.get('from_value') or '—'} → {e.get('to_value')}"
        actor = e.get("actor_title")
        print(f"[{e['ts']}] {e['kind']:9s} {e['task_id']:38s}{arrow}"
              + (f"  {actor}" if actor and actor != "—" else "")
              + (f"  — {e['note'][:70]}" if e.get("note") else ""))
    return 0


def cmd_embed(args) -> int:
    out = call("embed", args, "/api/embed", method="POST", body={"limit": args.limit},
               local_kwargs={"limit": args.limit}, fallback_warning=False, timeout=3600)
    emit(args, out, "", force_json=True)
    return 0


_ROUTING_SOURCE_TITLES = {
    "default": "по умолчанию",
    "config": "config.toml",
    "db": "база",
    "config+db": "config.toml+база",
}


def _print_routing(project: dict) -> None:
    """Печатает блок «маршрутизация» для одного проекта (см. `--routing` и показ)."""
    eff = project.get("routing_effective") or {}
    source = _ROUTING_SOURCE_TITLES.get(project.get("routing_source"),
                                        project.get("routing_source") or "?")
    print(f"маршрутизация (источник: {source}):")
    transitions = eff.get("transitions") or {}
    trans_line = ", ".join(f"{k.replace(':', '→')} {v}" for k, v in transitions.items())
    print(f"  переходы:  {trans_line or '—'}")
    hours = eff.get("return_window_hours")
    print(f"  окно возврата после красного вердикта: {hours if hours is not None else '—'} ч")


def _projects_table(rows: list[dict], *, with_path: bool = False) -> None:
    head = f"{'проект':40s} {'всего':>6s} {'живых':>6s} {'в работе':>9s}  {'тип':7s} скрыт"
    if with_path:
        head += "  каталог"
    print(head)
    for pr in rows:
        line = (f"{pr['slug']:40s} {pr.get('n_tasks', 0):6d} {pr.get('n_open', 0):6d} "
                f"{pr.get('n_wip', 0):9d}  {pr.get('kind', ''):7s} "
                f"{'да' if pr.get('archived') else '':4s}")
        if with_path:
            path = pr.get("path") or "—"
            mark = "" if not pr.get("path") or pr.get("path_exists") else "  (нет каталога)"
            line += f"  {path}{mark}"
        print(line)


def _routes_table(rows: list[dict]) -> None:
    head = f"{'#':>3s} {'ключ':24s} {'вид':9s} {'заголовок':32s} скрыт  нет скила"
    print(head)
    for i, r in enumerate(rows):
        title = (r.get("title") or "")[:32]
        print(f"{i:3d} {r.get('key', ''):24s} {r.get('kind', ''):9s} {title:32s} "
              f"{'да' if not r.get('visible') else '  ':4s}   "
              f"{'да' if r.get('skill_missing') else '':s}")


def cmd_projects(args) -> int:
    """Список репозиториев доски; добавление, скрытие и удаление.

    Доска показывает ровно те проекты, что лежат в таблице projects и не скрыты.
    Добавить репозиторий — значит прописать его каталог; убрать с доски — скрыть
    (задачи остаются в истории), удалить совсем — `--remove` (с задачами — --force).
    """
    if getattr(args, "routing", None) is not None:
        slug = getattr(args, "project", None)
        if not slug:
            raise errors.ListikError("нужен slug проекта", code=errors.BAD_ARGUMENT,
                                     hint="listik projects <slug> --routing '<json>'")
        try:
            parsed = json.loads(args.routing)
        except json.JSONDecodeError as exc:
            raise errors.ListikError(f"невалидный JSON маршрутизации: {exc}",
                                     code=errors.BAD_ARGUMENT,
                                     hint="пример: listik projects <slug> --routing "
                                          "'{\"transitions\": {\"s3-impl:s4-judge\": \"handoff\"}}'") from exc
        project = call("project_routing", args, f"/api/projects/{urllib.parse.quote(slug, safe='')}",
                       method="PATCH", body={"routing": parsed},
                       local_kwargs={"slug": slug, "routing": parsed}, fallback_warning=False)
        print(f"проект {project['slug']}: маршрутизация обновлена")
        _print_routing(project)
        return 0

    if getattr(args, "add", None):
        project_path = str(Path(args.add).expanduser().resolve())
        project = call("project_add", args, "/api/projects", method="POST",
                       body={"path": project_path, "slug": args.slug, "title": args.title,
                             "kind": args.kind or "native"},
                       local_kwargs={"path": project_path, "slug": args.slug,
                                     "title": args.title, "kind": args.kind or "native"},
                       fallback_warning=False)
        where = project.get("path") or "без каталога"
        what = "добавлен" if project.get("created") else "обновлён"
        if project.get("path_adjusted_from"):
            print(f"путь {project['path_adjusted_from']} лежит внутри репозитория — "
                  f"приведён к корню {project['path']}")
        print(f"проект {project['slug']} {what}: {where}"
              + ("  (git-репозиторий)" if project.get("git") else ""))
        return 0

    if getattr(args, "remove", None):
        out = call("project_remove", args,
                   f"/api/projects/{urllib.parse.quote(args.remove, safe='')}",
                   method="DELETE",
                   query={"force": "1"} if getattr(args, "force", False) else None,
                   local_kwargs={"slug": args.remove, "force": getattr(args, "force", False)},
                   fallback_warning=False)
        extra = f", вместе с ним удалено задач: {out['removed_tasks']}" if out.get("removed_tasks") else ""
        print(f"проект {out['slug']} удалён{extra}")
        return 0

    archived = getattr(args, "archive", None) or getattr(args, "unarchive", None)
    if archived:
        value = bool(getattr(args, "archive", None))
        call("project_archive", args,
             f"/api/projects/{urllib.parse.quote(archived, safe='')}", method="PATCH",
             body={"archived": 1 if value else 0},
             local_kwargs={"slug": archived, "archived": value}, fallback_warning=False)
        print(f"проект {archived}: {'скрыт с доски' if value else 'возвращён на доску'}")
        return 0

    res = call("projects", args, "/api/projects", local_kwargs={}, fallback_warning=False)
    rows = res["projects"]
    if getattr(args, "project", None):  # без действия slug — показать один проект
        rows = [row for row in rows if row["slug"] == args.project]
        if not rows:
            raise errors.ListikError(f"проект не найден: {args.project}", code=errors.NOT_FOUND,
                                     hint="список проектов: listik projects")
    if not getattr(args, "include_archived", False):
        rows = [row for row in rows if not row.get("archived")]
    if getattr(args, "json", False):
        emit(args, rows, "")
        return 0
    _projects_table(rows, with_path=bool(getattr(args, "project", None)))
    if getattr(args, "project", None) and rows:
        print()
        _print_routing(rows[0])
    print(f"\nвсего: {len(rows)}"
          + (f"  (скрытых тоже: --include-archived)" if not getattr(args, "include_archived", False) else "")
          + f"  корень проектов: {res.get('root') or '—'}")
    return 0


def cmd_actors(args) -> int:
    res = call("meta", args, "/api/meta", local_kwargs={})
    if getattr(args, "json", False):
        emit(args, res["actors"], "")
        return 0
    for a in res["actors"]:
        print(f"  {a['key']:22s} {(a['title'] or ''):26s} {a['kind']:6s} "
              f"задач {a['n_tasks']:4d}  держит {a['n_held']:3d}")
    return 0


def cmd_routes(args) -> int:
    """Маршруты запуска: список из таблицы `routes` (через сервер или локально)."""
    return _cmd_routes_list(args)


def _cmd_routes_list(args) -> int:
    data = call("routes", args, "/api/routes", local_kwargs={}, fallback_warning=False)
    rows = data.get("routes") or []
    if getattr(args, "json", False):
        emit(args, data, "")
        return 0
    if not data.get("ok", True):
        print(f"! маршруты недоступны: {data.get('error')}")
    _routes_table(rows)
    for w in data.get("warnings") or []:
        print(f"! {w}")
    print(f"\nвсего: {len(rows)}")
    return 0


def cmd_dep(args) -> int:
    # add без явного типа — жёсткая блокировка; link (по упоминаниям) — мягкая связь;
    # rm без типа должен уйти как None (снимает и blocks, и suggested-blocks разом).
    if args.action not in ("rm", "suggested") and not args.dep_type:
        args.dep_type = "relates-to" if args.action == "link" else "blocks"
    if args.action == "suggested":
        out = call("dep_suggested", args, "/api/deps/suggested",
                   query={"project": getattr(args, "project", None), "limit": args.limit},
                   local_kwargs={"project": getattr(args, "project", None), "limit": args.limit})
        items = out.get("items", []) if isinstance(out, dict) else out
        if getattr(args, "json", False):
            emit(args, items, "")
            return 0
        if not items:
            print("предложений нет")
            return 0
        for it in items:
            print(f"  {it['issue_id']:34s} ждёт  {it['depends_on']} [{it['depends_on_status']}]  "
                  f"предложил {it.get('created_by') or '—'} {it.get('created_at')}")
        print(f"\nвсего предложений: {len(items)}")
        return 0
    if args.action == "tree":
        if not args.issue_id:
            raise errors.ListikError("нужен ID задачи", code=errors.BAD_ARGUMENT,
                                     hint="listik dep tree <id>")
        args.task_id = args.issue_id
        args.depth = getattr(args, "depth", 3)
        return cmd_dep_tree(args)
    if args.action == "cycles":
        return cmd_dep_cycles(args)
    if args.action in ("suggest", "link"):
        if args.depends_on:
            # dep link/suggest работают только по упоминаниям в тексте; второй аргумент
            # раньше молча терялся (listik-u0ii). Явную связь ставит dep add.
            t = args.dep_type if args.action == "link" else "relates-to"
            raise errors.ListikError(
                f"dep {args.action} принимает только <id> и ищет упоминания в тексте; "
                f"второй аргумент {args.depends_on} не поддерживается",
                code=errors.BAD_ARGUMENT,
                hint=f"явная связь: listik dep add {args.issue_id} {args.depends_on} "
                     f"--dep-type {t}; одна из упомянутых задач: "
                     f"listik dep link {args.issue_id} --only {args.depends_on}")
        if not args.issue_id:
            raise errors.ListikError("нужен ID задачи", code=errors.BAD_ARGUMENT,
                                     hint="listik dep suggest <id>")
        items = call("mentions", args, f"/api/tasks/{args.issue_id}/mentions", method="POST",
                     body={"limit": args.limit},
                     local_kwargs={"task_id": args.issue_id, "limit": args.limit})
        if getattr(args, "json", False):
            emit(args, items, "")
        else:
            if not items:
                print(f"{args.issue_id}: неупомянутых несвязанных задач нет")
            for x in items:
                print(f"  {x['id']:34s} {x['status']:12s} {x['title'][:70]}")
            if items:
                print(f"\nсвязать как «relates-to» (не блокирует): "
                      f"listik dep link {args.issue_id} [--dep-type blocks]")
        if args.action == "link" and items:
            conn = db.init()
            made = 0
            for x in items:
                if args.only and args.only != x["id"]:
                    continue
                try:
                    store.add_dep(conn, args.issue_id, x["id"], args.dep_type,
                                  created_by=actor_default(args))
                    made += 1
                except errors.NotFound:
                    # Связать можно только с существующей задачей: пропускаем
                    # кандидата из поиска, которого уже нет.
                    continue
            print(f"создано связей: {made} (тип {args.dep_type})")
        return 0
    if args.action in ("add", "confirm"):
        dep_type = "blocks" if args.action == "confirm" else args.dep_type
        confirm = True if args.action == "confirm" else getattr(args, "confirm", False)
        out = call("dep_add", args, f"/api/tasks/{args.issue_id}/deps", method="POST",
                   body={"depends_on": args.depends_on, "dep_type": dep_type, "confirm": confirm,
                         "actor": actor_default(args)},
                   local_kwargs={"issue_id": args.issue_id, "depends_on": args.depends_on,
                                 "dep_type": dep_type, "confirm": confirm,
                                 "created_by": actor_default(args)})
        if out.get("suggested"):
            human = (f"предложение зависимости записано: {args.issue_id} ждёт {args.depends_on}; "
                     f"подтвердить: listik dep confirm {args.issue_id} {args.depends_on}")
        elif not out.get("created", True):
            human = "связь уже была"
        elif out.get("promoted"):
            human = (f"{args.issue_id} зависит от {args.depends_on} ({out.get('dep_type', dep_type)}) "
                     f"(подтверждена, предложение заменено)")
        else:
            human = f"{args.issue_id} зависит от {args.depends_on} ({out.get('dep_type', dep_type)})"
        emit(args, out, human)
        return 0
    # rm
    out = call("dep_remove", args, f"/api/tasks/{args.issue_id}/deps/{args.depends_on}",
               method="DELETE", query={"dep_type": args.dep_type} if args.dep_type else None,
               local_kwargs={"issue_id": args.issue_id, "depends_on": args.depends_on,
                             "dep_type": args.dep_type})
    if out.get("removed"):
        human = (f"связь снята: {args.issue_id} → {args.depends_on} "
                 f"({', '.join(out.get('dep_types') or [])})")
    else:
        human = "связи не было"
    emit(args, out, human)
    return 0


def cmd_token(args) -> int:
    cfg, token = client.config_mod.ensure_token()
    print(f"токен: {token}")
    print(f"конфиг: {paths.CONFIG_PATH}")
    print(f"доска: http://{cfg['server']['host']}:{cfg['server']['port']}/?token={token}")
    return 0


def cmd_mcp(args) -> int:
    from listik import mcp
    return mcp.run()


def cmd_service(args) -> int:
    from listik import service
    json_mode = bool(getattr(args, "json", False))
    if args.action == "install":
        info = service.install(args.bin, args.no_load, args.stop)
        if json_mode:
            emit(args, {"ok": True, **info}, "", force_json=True, indent=None)
        else:
            if info.get("stopped_pid"):
                print(f"запущенный вручную сервер остановлен (pid {info['stopped_pid']})")
            print(f"сервис установлен: {info['unit_path']}")
            print(f"бинарь: {info['bin']}")
            if args.no_load:
                print("не загружен (--no-load): listik service install без --no-load")
            else:
                print("сервис загружен")
        return 0
    if args.action == "uninstall":
        info = service.uninstall(args.no_load)
        if json_mode:
            emit(args, {"ok": True, **info}, "", force_json=True, indent=None)
        else:
            if info["existed"]:
                print(f"сервис удалён: {info['unit_path']}")
            else:
                print("сервис не установлен")
            if info["warning"]:
                print(info["warning"])
        return 0
    # action == "status"
    st = service.status()
    if json_mode:
        emit(args, st, "", force_json=True, indent=None)
        return 0
    print(f"платформа: {st['platform']}")
    print(f"юнит:      {st['unit_path']}")
    print(f"установлен: {'да' if st['installed'] else 'нет'}")
    loaded_text = {True: "да", False: "нет", None: "неизвестно"}[st["loaded"]]
    print(f"загружен:  {loaded_text}")
    print(f"бинарь:    {st['bin'] or '—'}")
    print(f"данные:    {st['data_dir']}")
    return 0


# ------------------------------------------------------------------ парсер

def build_parser() -> argparse.ArgumentParser:
    p = ListikParser(prog="listik", description="Listik — трекер задач и память")
    p.add_argument("--version", action="version", version=f"listik {__version__}")
    p.add_argument("--json", action="store_true", help="вывод в JSON (для агентов)")
    p.add_argument("--actor", help="кто выполняет действие (me, agent:dsh, ...)")
    p.add_argument("--owner",
                   help="от чьего имени: владелец-человек, серверный режим; "
                        "иначе LISTIK_OWNER, иначе [auth] owner в config.toml")
    p.add_argument("--harness", help="какой харнесс: dsh, grok, claude, codex")
    p.add_argument("--host", help="хост сервера Listik")
    p.add_argument("--port", type=int, help="порт сервера Listik")
    p.add_argument("--local", action="store_true",
                   help="работать с базой напрямую, минуя сервер "
                        "(пишущая команда при живом сервере предупредит: доска не получит событие)")
    sub = p.add_subparsers(dest="cmd", required=True)

    # Флаги, которые нужны после подкоманды: `listik list --json` читается лучше,
    # чем `listik --json list`, а агенты пишут именно так.
    common = argparse.ArgumentParser(add_help=False)
    # SUPPRESS (а не None): иначе значение из подкоманды перетирает глобальное,
    # и `listik --json stats` перестаёт быть JSON.
    common.add_argument("--json", action="store_true", default=argparse.SUPPRESS,
                        help="вывод в JSON (для агентов)")
    common.add_argument("--actor", default=argparse.SUPPRESS,
                        help="кто выполняет действие (me, agent:dsh, agent:claude, ...)")
    common.add_argument("--owner", default=argparse.SUPPRESS,
                        help="от чьего имени: владелец-человек, серверный режим; "
                             "иначе LISTIK_OWNER, иначе [auth] owner в config.toml")
    common.add_argument("--harness", default=argparse.SUPPRESS,
                        help="какой харнесс: dsh, grok, claude, codex")
    common.add_argument("--local", action="store_true", default=argparse.SUPPRESS,
                        help="работать с базой напрямую, минуя сервер "
                             "(пишущая команда при живом сервере предупредит: доска не получит событие)")

    def add(name: str, func, **kw):
        sp = sub.add_parser(name, parents=[common], **kw)
        sp.set_defaults(func=func)
        return sp

    def add_task_id(sp):
        sp.add_argument("task_id")

    def add_note(sp):
        sp.add_argument("--note")

    def add_holder(sp, *, help_text=None):
        sp.add_argument("--holder", **({"help": help_text} if help_text else {}))

    def add_task_note(sp):
        add_task_id(sp)
        add_note(sp)

    sp = add("serve", cmd_serve, help="поднять сервер и доску")
    sp.add_argument("-q", "--quiet", action="store_true")
    sp.add_argument("-d", "--daemon", action="store_true", help="уйти в фон (pid в listik.pid)")
    sp.add_argument("--no-embed", action="store_true",
                    help="не досчитывать векторы в фоне (ollama не нужен)")
    add("stop", cmd_stop, help="остановить фоновый сервер")
    add("status", cmd_status, help="состояние сервера, базы и поиска")
    add("init", cmd_init, help="создать/обновить базу")

    sp = add("backup", cmd_backup,
             help="согласованная копия базы (sqlite backup API, работает при живом сервере)",
             description="Копия снимается sqlite backup API прямо с файла базы (LISTIK_DB), "
                         "поэтому можно не останавливать сервер; --local не нужен. "
                         "Копировать listik.db/-wal через cp при работающем сервере нельзя.")
    sp.add_argument("--out", metavar="ФАЙЛ",
                    help="куда положить копию (по умолчанию рядом с базой: listik.db.bak-<время>)")
    sp.add_argument("--force", action="store_true", help="перезаписать существующий файл копии")

    sp = add("restore", cmd_restore,
             help="восстановить базу из копии (при работающем сервере отказывает)",
             description="Подменяет файл базы согласованной копией. Пока сервер Listik работает, "
                         "команда отказывает (conflict): его соединения остались бы на удалённом "
                         "inode. Останови сервер сам или добавь --stop. Перед восстановлением "
                         "текущая база копируется в listik.db.bak-pre-restore-<время>.")
    sp.add_argument("backup", metavar="КОПИЯ", help="файл, созданный `listik backup`")
    sp.add_argument("--stop", action="store_true",
                    help="остановить сервер Listik (SIGTERM) и восстановить базу")
    sp.add_argument("--force", action="store_true",
                    help="разрешить откат назад (в копии меньше задач, чем в текущей базе)")

    sp = add("init-projects", cmd_init_projects,
             help="прописать правила Listik в AGENTS.md/CLAUDE.md проектов, "
                  "а строку .worktrees/ — в их .gitignore")
    sp.add_argument("--dry-run", action="store_true", help="только показать, что изменится")
    sp.add_argument("--only", help="подстрока slug проекта")
    sp.add_argument("--remove", action="store_true",
                    help="убрать блок Listik из файлов (.gitignore не трогает)")
    sp.add_argument("-q", "--quiet", action="store_true")
    sp.add_argument("--force", action="store_true",
                    help="перезаписать блок, даже если его метка версии протокола новее шаблона")

    sp = add("import-from-bd", cmd_import_from_bd,
             help="идемпотентный импорт WriterLLM (работает с базой напрямую, --local не нужен)",
             description="Пишет в SQLite напрямую, как все импорты: запущенный сервер и --local "
                          "не нужны; HTTP-эндпоинта и MCP-инструмента у импорта нет.")
    sp.add_argument("--source", required=True,
                    help="JSONL из bd export или JSON-массив из bd list --json (файл; каталог не принимается)")
    sp.add_argument("--project", default="writerllm",
                    help="slug проекта для импортируемых задач (по умолчанию: writerllm)")
    sp.add_argument("--dry-run", action="store_true")
    sp.add_argument("--update", action="store_true",
                    help="обновлять поля уже импортированных задач и писать diff в журнал")

    sp = add("new", cmd_new, help="создать задачу")
    sp.add_argument("title")
    sp.add_argument("-p", "--project")
    sp.add_argument("-t", "--type", default="task")
    sp.add_argument("--priority", type=priority_value, default=2,
                    help="приоритет: 0–4 или P0–P4 (по умолчанию 2)")
    sp.add_argument("-d", "--description")
    sp.add_argument("-a", "--acceptance")
    sp.add_argument("--stage", choices=["s1-spec", "s2-review", "s3-impl", "s4-judge"])
    sp.add_argument("--assignee")
    sp.add_argument("-l", "--label", action="append")
    sp.add_argument("--spec")
    sp.add_argument("--checklist")
    sp.add_argument("--review")
    sp.add_argument("--decision")
    sp.add_argument("--journal")
    sp.add_argument("--route", metavar="КЛЮЧ",
                    help="ключ маршрута из таблицы routes; сервер помечает карточку метками "
                         "harness:/process:. Процесс при создании не запускается: карточку "
                         "берёт рой, вручную — listik launch")
    sp.add_argument("--parent", metavar="ID",
                    help="родительская карточка (шаг/эпик): новая карточка станет её порцией "
                         "(связь parent-child) со своими spec/checklist/review; проект и "
                         "journal_path наследуются от родителя, если не заданы")
    sp.add_argument("--discovered-from", metavar="ID",
                    help="карточка, при работе над которой задачу нашли: сразу ставит мягкую "
                         "связь discovered-from, и исходная карточка видит находку в связях")

    sp = add("list", cmd_list, help="список задач")
    sp.add_argument("-p", "--project")
    sp.add_argument("--status")
    sp.add_argument("--stage")
    sp.add_argument("--assignee")
    sp.add_argument("--holder")
    sp.add_argument("-t", "--type")
    sp.add_argument("--needs-owner", action="store_true")
    sp.add_argument("--mine", action="store_true", help="только мои (по --actor)")
    sp.add_argument("--stale", action="store_true", help="только брошенные")
    sp.add_argument("-a", "--all", action="store_true", help="включая закрытые")
    sp.add_argument("-n", "--limit", type=int, default=60)
    sp.add_argument("--order", default="updated",
                    choices=["updated", "created", "priority", "stage"])

    sp = add("show", cmd_show, help="карточка задачи")
    add_task_id(sp)
    sp.add_argument("--rejected", action="store_true",
                    help="показать карантин: отвергнутые записи зомби-процессов")
    sp.add_argument("--fields", action="append", metavar="ИМЯ[,ИМЯ…]",
                    help="только эти поля карточки (повторяемо или через запятую), "
                         "напр. --fields launch_route,labels; неизвестное поле — ошибка")

    sp = add("context", cmd_context, help="компактный контекст задачи для этапа")
    add_task_id(sp)
    sp.add_argument("--stage", required=True, choices=["s1-spec", "s2-review", "s3-impl", "s4-judge"])
    sp.add_argument("--portion")
    sp.add_argument("--max-chars", type=int, default=None)
    sp.add_argument("--format", choices=["text", "json"], default="text")

    _set_help = ("изменить поля: set <id> status=in_progress priority=1, "
                 "worktree=main — работа в основной ветке без дерева, "
                 "route=low-pipeline — маршрут, пока задача не начата, "
                 "write_scope=listik/store.py,docs/API.md — область правки "
                 "(пути от корня проекта через запятую; пусто — очистить)")
    sp = add("set", cmd_set, help=_set_help, description=_set_help)
    add_task_id(sp)
    sp.add_argument("field", nargs="+")
    add_note(sp)

    sp = add("worktree", cmd_worktree,
             help="завести или переиспользовать рабочее дерево задачи: "
                  "<проект>/.worktrees/<id>, ветка task/<id>, от текущего HEAD",
             description="Заводит дерево <проект>/.worktrees/<id> на ветке task/<id> от HEAD "
                         "основного дерева проекта и записывает путь и ветку в карточку. "
                         "Повторный запуск ничего не пересоздаёт: существующее дерево "
                         "переиспользуется как есть (status reused), грязное — тоже, файлы "
                         "не трогаются; протухшая запись (каталог удалён руками) "
                         "восстанавливается на той же ветке, коммиты ветки сохраняются. "
                         "--recreate удаляет и заводит дерево заново, но только когда терять "
                         "нечего: при незакоммиченных правках или коммитах ветки, которых нет "
                         "в HEAD проекта, команда отказывает и ничего не трогает. "
                         "Карточке с worktree=main/master дерево не заводится. "
                         "HTTP-эндпоинта у команды нет: git работает там, где запущен CLI.")
    add_task_id(sp)
    sp.add_argument("--track", metavar="ЧАСТЬ",
                    help="дерево параллельного трека: <id>-<часть>, ветка task/<id>-<часть>; "
                         "в карточку не пишется (строка из [a-z0-9-])")
    sp.add_argument("--recreate", action="store_true",
                    help="пересоздать дерево от HEAD проекта (отказ, если дерево грязное "
                         "или у ветки есть свои коммиты)")

    for name, func, helptext in (
        ("claim", cmd_claim, "взять задачу в работу"),
        ("heartbeat", cmd_heartbeat, "отметиться, что работаешь"),
    ):
        sp = add(name, func, help=helptext)
        add_task_id(sp)
        add_holder(sp)
        add_note(sp)
        if name == "claim":
            sp.add_argument("--force", action="store_true",
                            help="взять даже заблокированную (останется в истории)")

    sp = add("stage", cmd_stage,
             help="следующий этап конвейера (или --to; текущий этап — no-op с заметкой)")
    add_task_id(sp)
    add_holder(sp, help_text="кому выдать карточку: держатель ставится и пишется назначение; "
                            "без него на handoff держателя снимает, на том же этапе — тихий no-op")
    add_note(sp)
    sp.add_argument("--to", choices=["s1-spec", "s2-review", "s3-impl", "s4-judge", "done"],
                    help="явный этап; совпал с текущим — карточка не меняется, "
                         "заметка уходит в историю")

    sp = add("comment", cmd_comment, help="комментарий/журнал")
    add_task_id(sp)
    sp.add_argument("text")
    sp.add_argument("-k", "--kind", default="comment",
                    choices=["comment", "journal", "question", "answer", "review", "verdict"])

    sp = add("needs-owner", cmd_needs_owner, help="поднять/снять флаг «нужен человек»")
    add_task_id(sp)
    sp.add_argument("text", nargs="?")
    sp.add_argument("--clear", action="store_true")

    sp = add("release", cmd_release, help="освободить задачу")
    add_task_note(sp)

    sp = add("done", cmd_done, help="закрыть задачу")
    add_task_id(sp)
    sp.add_argument("-r", "--result")
    sp.add_argument("--reason")
    add_note(sp)

    sp = add("portions", cmd_portions, help="карточки порций шага по файлам <id>.<X>.md")
    sp.add_argument("action", choices=["sync"])
    add_task_id(sp)

    sp = add("revoke", cmd_revoke,
             help="отзыв поднимает поколение и по умолчанию снимает процесс")
    add_task_note(sp)
    sp.add_argument("--no-kill", action="store_true",
                    help="оставить процесс жить (не убивать, только отозвать полномочия)")

    sp = add("launch", cmd_launch,
             help="запуск стартует процесс по маршруту карточки следующим поколением")
    add_task_id(sp)
    sp.add_argument("--env", action="append", metavar="K=V",
                    help="дополнительное окружение процесса, LISTIK_* незарезервированные; "
                         "повторяемый")

    sp = add("search", cmd_search, help="гибридный поиск по всем задачам")
    sp.add_argument("query")
    sp.add_argument("-n", "--limit", type=int, default=15)
    sp.add_argument("--mode", choices=["hybrid", "text", "vector"], default="hybrid")
    sp.add_argument("-p", "--project")
    sp.add_argument("--stage")
    sp.add_argument("--status")

    sp = add("memory", cmd_memory, help="долговременная память: список или поиск")
    sp.add_argument("query", nargs="?")
    sp.add_argument("-n", "--limit", type=int, default=20)
    sp.add_argument("--project")

    sp = add("remember", cmd_remember, help="записать заметку в память")
    sp.add_argument("text")
    sp.add_argument("--key")
    sp.add_argument("-p", "--project")

    sp = add("ready", cmd_ready, help="что можно взять прямо сейчас (нет блокеров)")
    sp.add_argument("-p", "--project")
    sp.add_argument("--stage")
    sp.add_argument("-n", "--limit", type=int, default=40)
    sp.add_argument("--with-occupied", action="store_true", help="включая занятые кем-то")

    sp = add("blocked", cmd_blocked, help="кто кого ждёт: незакрытые блокеры задач")
    sp.add_argument("-p", "--project")
    sp.add_argument("-n", "--limit", type=int, default=60)

    sp = add("lint", cmd_lint,
             help="несостыковки карточек проекта: держатели, документы, порции, связи")
    sp.add_argument("-p", "--project")
    sp.add_argument("--suggested-hours", type=float, default=None,
                    help="через сколько часов неподтверждённая предложенная связь — находка "
                    "(по умолчанию 24)")
    sp.add_argument("--stop-hook", action="store_true",
                    help="режим Stop-хука Claude Code: stdin — JSON хука, при находках "
                    "на stdout {\"decision\": \"block\"}, код всегда 0; несовместим с --json")

    sp = add("waves", cmd_waves, help="волны запуска: что можно делать одновременно")
    sp.add_argument("-p", "--project")
    sp.add_argument("--stage")
    sp.add_argument("--apply", action="store_true",
                    help="записать ресурсные рёбра resource-blocks в базу под этот расчёт: "
                    "устаревшие снять, недостающие поставить")

    sp = add("swarm", cmd_swarm,
             help="включить рой в config.toml: сервер сам гоняет все проекты")
    sp.add_argument("state", choices=["on", "off", "status"],
                    help="on — [swarm] enabled = true; off — false; status — что сейчас")

    sp = add("plan", cmd_plan, help="LLM-проход роя: грубые зависимости между открытыми "
                                    "задачами проекта — какие ТЗ можно писать параллельно")
    sp.add_argument("-p", "--project")
    sp.add_argument("--stage")
    sp.add_argument("--apply", action="store_true",
                    help="записать рёбра blocks от agent:listik-swarm: свои устаревшие "
                    "снять, новые поставить; человеческие не трогаются")

    sp = add("rescope", cmd_rescope,
             help="LLM-проход роя: области read_scope/write_scope из готовых ТЗ и "
                  "уточнение графа по копилке расхождений")
    sp.add_argument("-p", "--project")
    sp.add_argument("--task", action="append", metavar="ID",
                    help="ограничить чтение ТЗ этими карточками")
    sp.add_argument("--drift", metavar="FILE",
                    help="JSON-список записей копилки {task, declared, touched|files, "
                    "outside} сверх записей из карточек")
    sp.add_argument("--apply", action="store_true",
                    help="записать области в карточки и рёбра blocks от agent:listik-swarm")

    sp = add("watch", cmd_watch,
             help="наблюдатель деревьев роя: тронутые файлы, пробное слияние по парам, "
                  "расхождения с write_scope")
    sp.add_argument("--project", help="проект: слаг из listik projects")
    sp.add_argument("--task", action="append", metavar="ID",
                    help="ограничить карточками (повторяемый)")
    sp.add_argument("--dry-run", action="store_true",
                    help="не писать журнальные записи в карточки")

    sp = add("inbox", cmd_inbox, help="что требует человека: вопросы и брошенные задачи")
    sp.add_argument("--project")
    sp.add_argument("-n", "--limit", type=int, default=25)

    sp = add("board", cmd_board, help="состояние доски в терминале")
    sp.add_argument("--group-by", default="status",
                    choices=["status", "stage", "project", "holder"])
    sp.add_argument("-p", "--project")
    sp.add_argument("-a", "--all", action="store_true")

    sp = add("stats", cmd_stats, help="сводка")
    sp.add_argument("-p", "--project")

    sp = add("timeline", cmd_timeline, help="лента событий")
    sp.add_argument("--project")
    sp.add_argument("-n", "--limit", type=int, default=60)

    sp = add("embed", cmd_embed, help="досчитать векторы (ollama bge-m3)")
    sp.add_argument("--limit", type=int, default=0)

    sp = add("projects", cmd_projects,
             help="репозитории доски: список, добавить, скрыть, убрать")
    sp.add_argument("project", nargs="?", help="показать один проект подробно")
    sp.add_argument("--add", metavar="ПУТЬ", help="добавить репозиторий (каталог) на доску")
    sp.add_argument("--slug", metavar="SLUG", help="slug для --add (по умолчанию имя каталога)")
    sp.add_argument("--title", help="человеческое название проекта")
    sp.add_argument("--kind", help="тип проекта (по умолчанию native)")
    sp.add_argument("--remove", metavar="SLUG", help="убрать проект из Listik")
    sp.add_argument("--force", action="store_true",
                    help="с --remove: удалить проект вместе с его задачами")
    sp.add_argument("--archive", metavar="SLUG", help="скрыть проект с доски")
    sp.add_argument("--unarchive", metavar="SLUG", help="вернуть проект на доску")
    sp.add_argument("--include-archived", action="store_true", help="показать и скрытые")
    sp.add_argument("--routing", metavar="JSON",
                    help="установить переопределение маршрутизации проекта (JSON); "
                         "'{}' — сбросить; нужен позиционный slug проекта")
    add("actors", cmd_actors, help="список исполнителей")

    add("routes", cmd_routes, help="маршруты запуска: список из таблицы routes")

    sp = add("dep", cmd_dep,
             help="связи между задачами: add, confirm, rm, tree, cycles, suggest, link, suggested")
    sp.add_argument("action", choices=["add", "confirm", "rm", "tree", "cycles", "suggest",
                                       "link", "suggested"])
    sp.add_argument("issue_id", nargs="?", help="задача; для tree — та, чьё дерево строим")
    sp.add_argument("depends_on", nargs="?", help="от чего зависит (для add/confirm/rm; "
                    "link/suggest второй аргумент отвергают — используйте dep add --dep-type)")
    sp.add_argument("--dep-type", default=None,
                    help="тип связи: blocks (жёсткая блокировка, по умолчанию для add), "
                         "relates-to (по умолчанию для link), parent-child, waits-for; "
                         "resource-blocks ставит только планировщик роя, через dep add не "
                         "принимается")
    sp.add_argument("-d", "--depth", type=int, default=3)
    sp.add_argument("-n", "--limit", type=int, default=50)
    sp.add_argument("--only", help="связать только с этой задачей")
    sp.add_argument("--confirm", action="store_true", help="подтвердить жёсткую зависимость агента")
    sp.add_argument("--project", help="фильтр по проекту (для suggested)")

    sp = add("tree", cmd_dep_tree, help="дерево зависимостей задачи (то же, что dep tree)")
    add_task_id(sp)
    sp.add_argument("-d", "--depth", type=int, default=3)
    add("cycles", cmd_dep_cycles, help="циклы в зависимостях")

    add("token", cmd_token, help="показать токен и ссылку на доску")
    add("mcp", cmd_mcp, help="MCP-сервер (stdio) для агентов")

    sp = add("service", cmd_service,
             help="автозапуск сервера: install, uninstall, status (launchd/systemd --user)")
    sp.add_argument("action", choices=["install", "uninstall", "status"])
    sp.add_argument("--bin", help="бинарь listik для юнита (по умолчанию: обёртка "
                                  "LISTIK_WRAPPER, иначе ROOT_DIR/bin/listik)")
    sp.add_argument("--no-load", action="store_true",
                    help="только записать/удалить юнит, не (пере)загружать сервис")
    sp.add_argument("--stop", action="store_true",
                    help="install: остановить сервер, запущенный вручную, вместо отказа")

    return p


def main(argv: list[str] | None = None) -> int:
    raw = list(sys.argv[1:] if argv is None else argv)
    # --json может стоять и до подкоманды, и после: ошибка разбора аргументов
    # случается раньше, чем флаг попадёт в args, поэтому смотрим сам argv.
    # После «--» флагов уже нет — там текст («--json» как комментарий).
    try:
        after_dashdash = raw.index("--")
    except ValueError:
        after_dashdash = len(raw)
    json_mode = "--json" in raw[:after_dashdash]
    try:
        args = build_parser().parse_args(raw)
    except errors.ListikError as exc:
        return report_error(exc, json_mode)
    except SystemExit:  # --help/--version: argparse уже всё напечатал
        return 0
    if not hasattr(args, "json"):
        args.json = False
    json_mode = json_mode or args.json
    # lint --stop-hook определяет проект сам: сначала stdin хука, потом база.
    if (getattr(args, "cmd", None) in PROJECT_DEFAULT_COMMANDS
            and not getattr(args, "stop_hook", False)):
        args.project = project_default(args)
    try:
        return int(args.func(args) or 0)
    except (errors.ListikError, KeyError, ValueError, PermissionError) as exc:
        # Ожидаемые ошибки: разбор аргументов, «не найдено» (errors.NotFound),
        # «нельзя сделать». Трейсбек им не нужен — он остаётся непойманным.
        err = errors.as_error(exc)
        if err.code == errors.INTERNAL and not isinstance(exc, errors.ListikError):
            # Голый KeyError словаря (нет поля у карточки) — это наша ошибка, а не
            # «не найдено»: пишем трейсбек в listik.log и не советуем «проверь
            # идентификатор» (listik-xut1).
            log_traceback(exc)
            err.hint = err.hint or f"подробности в {paths.LOG_PATH}"
        return report_error(err, json_mode)
    except SystemExit as exc:  # чужой SystemExit(строка) — в тот же формат
        if exc.code in (None, 0):
            return 0
        message = exc.code if isinstance(exc.code, str) else "команда прервана"
        return report_error(errors.ListikError(message, code=errors.BAD_ARGUMENT), json_mode)
    except KeyboardInterrupt:
        return report_error(errors.ListikError("прервано (Ctrl+C)", code=errors.INTERNAL,
                                               hint="команда не выполнена", exit_code=130),
                            json_mode)
    except Exception as exc:  # noqa: BLE001 — трейсбек уходит только в listik.log
        log_traceback(exc)
        err = errors.as_error(exc)
        err.hint = err.hint or f"подробности в {paths.LOG_PATH}"
        return report_error(err, json_mode)


if __name__ == "__main__":
    raise SystemExit(main())
