               local_kwargs={**body, "task_id": args.task_id})
    emit(args, out, f"добавлено в {args.task_id} ({args.kind})")
    return 0


def cmd_needs_owner(args) -> int:
    actor = actor_default(args)
    body = {"value": not args.clear, "note": args.text, "actor": actor, "harness": args.harness}
    task = call("needs-owner", args, f"/api/tasks/{args.task_id}/needs-owner", method="POST",
                body=body, local_kwargs={"task_id": args.task_id, "value": not args.clear,
                                         "text": args.text, "actor": actor,
                                         "harness": args.harness})
    state = "снят" if args.clear else "поднят"
    emit(args, task, f"флаг «нужен человек» {state}: {task['id']}")
    if not getattr(args, "json", False):
        if args.text and not args.clear:
            print(f"  вопрос: {args.text}")
        elif args.text and args.clear:
            print(f"  ответ: {args.text}")
    return 0


