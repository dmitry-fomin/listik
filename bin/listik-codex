#!/usr/bin/env python3
"""Thin Claude→Codex launcher for one Listik task."""
from __future__ import annotations
import argparse, json, os, subprocess, sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
LISTIK = ROOT / "bin" / "listik"

def run(*args: str) -> str:
    p = subprocess.run([str(LISTIK), *args], cwd=ROOT, text=True, capture_output=True)
    if p.returncode:
        raise RuntimeError(p.stderr.strip() or p.stdout.strip())
    return p.stdout

def main() -> int:
    ap = argparse.ArgumentParser(description="запустить Codex для карточки Listik")
    ap.add_argument("task_id"); ap.add_argument("--stage", required=True, choices=("s1-spec", "s2-review"))
    ap.add_argument("--model", default="terra", choices=("terra", "luna")); ap.add_argument("--cd", default=os.getcwd())
    ap.add_argument("--resume", help="session id Codex")
    args = ap.parse_args()
    try:
        run("show", args.task_id, "--json")
        context = run("context", args.task_id, "--stage", args.stage, "--format", "json")
    except Exception as exc:
        print(f"Listik: не удалось собрать контекст: {exc}", file=sys.stderr); return 2
    role = "writer спецификации" if args.stage == "s1-spec" else "критик спецификации"
    prompt = (f"Ты {role} в harness-протоколе Listik. Task ID: {args.task_id}. "
              f"Работай только в указанном repository/worktree. Прочитай контекст ниже и "
              f"запиши решения в Listik journal. Этап: {args.stage}.\n\n{context}")
    if args.resume:
        command = ["codex", "exec", "resume", args.resume, "--cd", args.cd, "--model", args.model, prompt, "--json"]
    else:
        command = ["codex", "exec", "--cd", args.cd, "--model", args.model, prompt, "--json"]
    proc = subprocess.run(command, text=True, capture_output=True)
    output = (proc.stdout or "")[-12000:]
    session = None
    for line in (proc.stdout or "").splitlines():
        try:
            obj = json.loads(line)
            session = session or obj.get("session_id") or obj.get("id")
        except json.JSONDecodeError: pass
    note = f"codex launcher stage={args.stage} model={args.model} exit={proc.returncode} session={session or 'unknown'}\n{output}"
    subprocess.run([str(LISTIK), "comment", args.task_id, note, "-k", "journal"], cwd=ROOT)
    if proc.returncode: print(proc.stderr, file=sys.stderr)
    return proc.returncode

if __name__ == "__main__": raise SystemExit(main())
