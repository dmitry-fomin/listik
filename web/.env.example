# База API. Пусто (по умолчанию) — тот же origin, под которым отдана страница:
#   в прод сборку отдаёт сам ./bin/listik serve, в dev /api проксирует vite.config.ts.
# Задайте адрес, только если API живёт на другом хосте/порту:
# VITE_API_BASE=http://127.0.0.1:8787

# Токен для отладки, чтобы не вводить его руками. В обычной работе приложение
# берёт токен из localStorage['listik.token'].
# VITE_LISTIK_TOKEN=
